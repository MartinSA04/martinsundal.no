---
import { getEntry, render } from "astro:content";
import ProjectShell from "../../components/project/ProjectShell.astro";
import ProjectHead from "../../components/project/ProjectHead.astro";
import ProjectLinks from "../../components/project/ProjectLinks.astro";
import SpecBlock from "../../components/micro/SpecBlock.astro";
import Icon from "../../components/micro/Icon.astro";
import VideoFacade from "../../components/work/VideoFacade.astro";
import "../../worlds/cipherbound.css";

const entry = await getEntry("projects", "cipherbound");
if (!entry) throw new Error("missing content: projects/cipherbound");
const { Content } = await render(entry);
---

{
  /* Shape: a handheld screen. Nothing runs the full width of the viewport;
    the page is a stack of framed panels in a narrow centred column, the way a
    GBA menu is a stack of boxes. Spec and links sit in a two-up "status"
    panel rather than a rail, because a rail is a desktop-document idea. */
}
<ProjectShell entry={entry} class="cb">
  <div class="cb-screen">
    <div class="cb-panel cb-frame">
      <ProjectHead entry={entry} />
    </div>

    <div class="cb-video cb-frame">
      <VideoFacade
        poster="/cipherbound/poster.avif"
        webm="/cipherbound/trailer.webm"
        mp4="/cipherbound/trailer.mp4"
        width={1280}
        height={720}
        duration="0:33"
        label="Play the Cipherbound trailer"
        posterAlt="Cipherbound gameplay: a pixel-art overworld with the player character"
      />
    </div>

    <div class="cb-dialogue cb-frame" data-cb-dialogue>
      <span class="cb-speaker">SYSTEMS</span>
      {
        /* The first line is server-rendered, so the box says something even
          before the script runs. Everything it says also appears in the prose
          below — the interaction hides nothing. */
      }
      <p class="cb-text" data-cb-text>
        Every tile carries its own walkability, so the world is data. A new area
        is a new file, not new code.
      </p>
      <div class="cb-progress" data-cb-pips aria-hidden="true"></div>
      <button class="cb-next" type="button" data-cb-next aria-label="Next line">
        Next <Icon name="caret-down" size={14} />
      </button>
    </div>

    <div class="cb-panel cb-frame">
      <div class="prose">
        <Content />
      </div>
    </div>

    <div class="cb-status">
      <section class="cb-panel cb-frame" aria-label="Stats">
        <span class="cb-speaker">Stats</span>
        <SpecBlock rows={entry.data.spec} />
      </section>

      <section class="cb-panel cb-frame" aria-label="Links">
        <span class="cb-speaker">Links</span>
        <ProjectLinks entry={entry} />
        {entry.data.award ? <p class="award">{entry.data.award}</p> : null}
      </section>
    </div>
  </div>
</ProjectShell>

<div class="cb-sprite" data-cb-sprite aria-hidden="true"></div>

<script>
  import "../../worlds/cipherbound.ts";
</script>
