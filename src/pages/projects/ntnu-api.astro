---
import { getEntry, render } from "astro:content";
import ProjectShell from "../../components/project/ProjectShell.astro";
import "../../worlds/ntnu-api.css";

const entry = await getEntry("projects", "ntnu-api");
if (!entry) throw new Error("missing content: projects/ntnu-api");
const { Content } = await render(entry);

const PRESETS = [
  { id: "search", label: "search_courses" },
  { id: "compare", label: "compare_courses" },
  { id: "conflicts", label: "check_timetable_conflicts" },
  { id: "grades", label: "get_grade_distribution" },
];
---

<ProjectShell entry={entry} centerpieceLabel="Live MCP console">
  <div slot="centerpiece" class="mcp" data-mcp>
    <div class="mcp-bar">
      <span class="mcp-dot" data-mcp-dot aria-hidden="true"></span>
      <span class="micro-label">ntnu-mcp.martinsundal.no/mcp</span>
      <span class="micro-label" data-mcp-status>idle</span>
      <span class="micro-label" style="margin-left:auto">streamable-http · 2025-06-18</span>
    </div>

    <div class="mcp-presets">
      {
        PRESETS.map((p) => (
          <button type="button" data-mcp-preset={p.id} aria-pressed="false">
            {p.label}
          </button>
        ))
      }
    </div>

    <div class="mcp-panes">
      <div class="mcp-pane">
        <span class="micro-label">JSON-RPC over the wire</span>
        <pre data-mcp-wire>Pick a tool above. The request and response that
cross the network appear here, unedited.</pre>
      </div>
      <div class="mcp-pane">
        <span class="micro-label">Result</span>
        <div data-mcp-result>
          <p class="micro-label">
            This console is a hand-written MCP client. It calls the real server
            from your browser — nothing here is recorded.
          </p>
        </div>
      </div>
    </div>

    <div class="mcp-fallback" data-mcp-fallback hidden></div>
  </div>

  <Content />
</ProjectShell>

<script>
  import "../../worlds/ntnu-api.ts";
</script>
