---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import WorkBand from "../components/home/WorkBand.astro";
import ProjectIndex from "../components/home/ProjectIndex.astro";
import Contact from "../components/home/Contact.astro";
import Rule from "../components/micro/Rule.astro";
import { orderedProjects } from "../lib/content.ts";
import { homeGraph, SITE } from "../lib/jsonld.ts";

const projects = await orderedProjects();
const graph = homeGraph(projects.map((e) => ({ id: e.id, data: e.data })));

const title = "Martin Sundal Aspås | Software Engineer, Robotics & Simulation";
const description =
  "Software engineer in Trondheim. I build robotics, simulation and industrial software at Aker Solutions, and study Applied Physics and Mathematics at NTNU.";
---

<Base
  title={title}
  description={description}
  canonicalPath="/"
  ogImage={`${SITE}/og/home.png`}
  ogType="profile"
  graph={graph}>
  <Hero />
  <WorkBand />
  <ProjectIndex projects={projects} />

  <section id="about" class="about card">
    <div class="wrap">
      <Rule label="Idx_03 / About" />
      <div class="cols">
        <p>
          I build software for the physical world, where geometry and motion
          drive the design, and for the systems that have to keep running
          around it.
        </p>
        <p>
          Alongside that I study Applied Physics and Mathematics at NTNU. The
          side projects are how I learn things properly: a game engine written
          from scratch teaches more about architecture than any tutorial, and a
          renderer that bends light teaches the geometry it is modelling.
        </p>
      </div>
    </div>
  </section>

  <Contact />
</Base>

<style>
  .about {
    padding-block: var(--space-5);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-3);
    max-width: 72ch;
  }

  .cols p {
    color: var(--muted);
  }
</style>
