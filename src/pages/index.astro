---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import WorkBand from "../components/home/WorkBand.astro";
import ProjectIndex from "../components/home/ProjectIndex.astro";
import Contact from "../components/home/Contact.astro";
import Mark from "../components/micro/Mark.astro";
import Plate from "../components/micro/Plate.astro";
import Readout from "../components/micro/Readout.astro";
import Figure from "../components/micro/Figure.astro";
import { orderedProjects } from "../lib/content.ts";
import { homeGraph, SITE } from "../lib/jsonld.ts";

const projects = await orderedProjects();
const graph = homeGraph(projects.map((e) => ({ id: e.id, data: e.data })));

const title = "Martin Sundal Aspås | Software Engineer, Robotics & Simulation";
const description =
  "Software engineer in Trondheim. I build robotics, simulation and industrial software at Aker Solutions, and study Applied Physics and Mathematics at NTNU.";
---

<Base
  title={title}
  description={description}
  canonicalPath="/"
  ogImage={`${SITE}/og/home.png`}
  ogType="profile"
  graph={graph}
>
  <Hero />
  <WorkBand />
  <ProjectIndex projects={projects} />

  <section id="about" class="about card">
    <div class="wrap">
      <Mark n={4} label="Notes" figure="tangent" />

      {
        /* The statement used to be a large sentence floating in whitespace —
          the most generic element on the page. Same words, now bounded and
          registered, with the context beside it as readouts rather than as a
          second paragraph of prose. */
      }
      {
        /* Lozenge stacks as the walls of the block, the way the reference
          sheets bracket a text cluster: the figures are the container rather
          than decoration sitting inside one. Mirrored, so the pair reads as a
          single bracket instead of two loose marks. */
      }
      <Plate variant="corners" edgeLeft="Notes 2026_MSA_04">
        <div class="cols">
          <div class="wall" aria-hidden="true">
            <Figure name="lozenges" size={68} />
            <Figure name="lozenges" size={44} />
          </div>

          <p class="statement">
            I build software for the physical world, where geometry and motion
            drive the design, and for the systems that have to keep running
            around it.
          </p>

          <Readout
            layout="stack"
            pairs={[
              { label: "Studying", value: "Applied physics & maths, NTNU" },
              {
                label: "Engine",
                value: "Architecture, taught by building one",
              },
              { label: "Renderer", value: "Geometry, taught by bending light" },
            ]}
          />

          <div class="wall" data-mirror aria-hidden="true">
            <Figure name="lozenges" size={44} />
            <Figure name="lozenges" size={68} />
          </div>
        </div>
      </Plate>
    </div>
  </section>

  <Contact />
</Base>

<style>
  /* Tighter than the bands above it on purpose: after five project rows the
     page needs to slow down, not present another full-width section. */
  .about {
    padding-block: var(--space-4);
  }

  .cols {
    display: grid;
    grid-template-columns: auto minmax(0, 1.35fr) minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
  }

  /* The walls run vertically, so the lozenges are turned onto their side and
     stacked — the same figure the section mark uses, rotated into a bracket. */
  .wall {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    rotate: 90deg;
    color: var(--hair);
  }

  .wall[data-mirror] {
    rotate: -90deg;
  }

  /* Reading scale, not display scale. The sentence carries weight from being
     bounded and annotated rather than from being set large. */
  .statement {
    font-size: var(--step-1);
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-wrap: pretty;
    max-width: 46ch;
  }

  @media (max-width: 46rem) {
    .cols {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    /* The walls need horizontal room the phone layout does not have. */
    .wall {
      display: none;
    }
  }
</style>
