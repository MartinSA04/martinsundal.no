---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import WorkBand from "../components/home/WorkBand.astro";
import ProjectIndex from "../components/home/ProjectIndex.astro";
import Contact from "../components/home/Contact.astro";
import Rule from "../components/micro/Rule.astro";
import { orderedProjects } from "../lib/content.ts";
import { homeGraph, SITE } from "../lib/jsonld.ts";

const projects = await orderedProjects();
const graph = homeGraph(projects.map((e) => ({ id: e.id, data: e.data })));

const title = "Martin Sundal Aspås | Software Engineer, Robotics & Simulation";
const description =
  "Software engineer in Trondheim. I build robotics, simulation and industrial software at Aker Solutions, and study Applied Physics and Mathematics at NTNU.";
---

<Base
  title={title}
  description={description}
  canonicalPath="/"
  ogImage={`${SITE}/og/home.png`}
  ogType="profile"
  graph={graph}
>
  <Hero />
  <WorkBand />
  <ProjectIndex projects={projects} />

  <section id="about" class="about card">
    <div class="wrap">
      <Rule label="Idx_03 / About" />
      <div class="cols">
        <p class="statement">
          I build software for the physical world, where geometry and motion
          drive the design, and for the systems that have to keep running around
          it.
        </p>
        <p>
          Alongside that I study Applied Physics and Mathematics at NTNU. The
          side projects are how I learn things properly: a game engine written
          from scratch teaches more about architecture than any tutorial, and a
          renderer that bends light teaches the geometry it is modelling.
        </p>
      </div>
    </div>
  </section>

  <Contact />
</Base>

<style>
  /* Tighter than the bands above it on purpose: after five project rows the
     page needs to slow down, not present another full-width section. */
  .about {
    padding-block: var(--space-6);
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-4);
    align-items: start;
  }

  /* The one sentence that has to land carries the size; the context around it
     stays at reading scale. */
  .statement {
    font-size: var(--step-2);
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .cols p:not(.statement) {
    color: var(--muted);
    max-width: 48ch;
  }

  @media (max-width: 46rem) {
    .cols {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .statement {
      font-size: var(--step-1);
    }
  }
</style>
