---
/**
 * FIG. 02 — Selected work, plotted.
 *
 * The projects are placed on a real field: X is runtime, from systems C++ to
 * scripted TypeScript; Y is subject, from tooling and data up to geometry and
 * motion. Position means something, so the arrangement is an argument rather
 * than an ordering.
 *
 * Each point is called out into the plot's own margin on its own leader, which
 * is what makes the field readable on its own. The callout says which project a
 * point IS and where it sits; the description belongs to the specimen below and
 * is not repeated up here.
 *
 * The callouts are labels on a diagram, so they are aria-hidden — the navigable
 * entry for every project is its specimen, which carries the same coordinate.
 *
 * Placement lives here rather than in frontmatter: where a project sits on this
 * particular field is presentation, and the content has no business carrying it.
 */
import type { CollectionEntry } from "astro:content";
import ProjectFigure from "./ProjectFigure.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

/* Plot geometry. The box is small inside a wide viewBox on purpose: the margins
   are where the callouts live. */
const L = 330;
const R = 700;
const T = 90;
const B = 430;
const px = (v: number) => L + v * (R - L);
const py = (v: number) => B - v * (B - T);

type Placement = {
  /** 0 = systems / C++, 1 = scripted / TS */
  x: number;
  /** 0 = tooling & data, 1 = geometry & motion */
  y: number;
  /** Leader from the point out to its callout, in plot coordinates. */
  leader: string;
  /** Where the callout sits over the field. */
  co: string;
  /** Weight on the sheet. The specimens are deliberately not uniform. */
  size: "xl" | "lg" | "md" | "sm";
  /** Placement on the 12-column specimen field. */
  cell: string;
};

const PLACE: Record<string, Placement> = {
  "black-hole": {
    x: 0.1,
    y: 0.92,
    leader: "M367 117.2 L338 90 H300",
    co: "right:72.4%;top:11.6%;width:26%;text-align:right",
    size: "xl",
    cell: "grid-column:3/10;grid-row:2;margin-top:var(--loose)",
  },
  cipherbound: {
    x: 0.18,
    y: 0.62,
    leader: "M396.6 219.2 L366 252 H300",
    co: "right:72.4%;top:36.9%;width:26%;text-align:right",
    size: "xl",
    cell: "grid-column:1/8;grid-row:3;margin-top:calc(var(--loose) * .5)",
  },
  "game-of-life": {
    x: 0.7,
    y: 0.78,
    leader: "M589 164.8 L660 120 H730",
    co: "left:73.6%;top:16.3%;width:26%",
    size: "md",
    cell: "grid-column:9/13;grid-row:3;margin-top:calc(var(--loose) * .9)",
  },
  "study-companion": {
    x: 0.8,
    y: 0.24,
    leader: "M626 348.4 L672 316 H730",
    co: "left:73.6%;top:46.9%;width:26%",
    size: "xl",
    cell: "grid-column:8/13;grid-row:1;margin-top:96px",
  },
  "ntnu-api": {
    x: 0.88,
    y: 0.1,
    leader: "M655.6 396 L690 440 H730",
    co: "left:73.6%;top:66.3%;width:26%",
    size: "xl",
    cell: "grid-column:1/8;grid-row:1",
  },
};

const ordered = projects
  .map((entry) => ({ entry, p: PLACE[entry.id]! }))
  .filter((r) => r.p)
  .sort((a, b) => a.entry.data.index - b.entry.data.index)
  .map((r) => ({
    ...r,
    n: String(r.entry.data.index).padStart(2, "0"),
    X: px(r.p.x),
    Y: py(r.p.y),
  }));

/* Graduations per axis. Numbered from 1 rather than 0, so the count is 42 and
   the majors fall on the sixths — the origin needs no tick of its own, since
   the two axes already meet there. */
const TICKS = 42;
const ticks = Array.from({ length: TICKS }, (_, n) => ({
  v: (n + 1) / TICKS,
  major: (n + 1) % 7 === 0,
}));
const dots = Array.from({ length: 19 }, (_, x) =>
  Array.from({ length: 17 }, (_, y) => ({
    cx: L + ((R - L) * x) / 18,
    cy: T + ((B - T) * y) / 16,
  })),
).flat();
const fan = Array.from({ length: 15 }, (_, i) => {
  const a = ((i + 1) / 16) * (Math.PI / 2);
  return { x2: L + Math.cos(a) * 470, y2: B - Math.sin(a) * 470 };
});
---

<section id="projects" class="zone work" aria-labelledby="work-h">
  <div class="sec-head">
    <h2 id="work-h" class="p-u p-u--lg p-u--ink zh">
      Fig. 02 — Selected work<span class="plotted">, plotted</span>
    </h2>
    <span class="p-u p-tag"
      >{ordered.length} specimens<span class="plotted">
        · not uniform</span
      ></span
    >
    <span class="p-scale" aria-hidden="true"></span>
  </div>

  <p class="p-u p-u--n work-note">
    X is runtime, Y is subject. Each project carries its coordinates again
    below; hover either and the other lights up.
  </p>

  <div class="field-map">
    <svg
      class="plot"
      viewBox="0 0 1000 640"
      role="img"
      aria-label="A scatter field. Five projects are plotted by runtime on the horizontal axis, from systems C++ to scripted TypeScript, and by subject on the vertical axis, from tooling and data up to geometry and motion."
    >
      <defs>
        <clipPath id="plot-box">
          <rect x={L} y={T} width={R - L} height={B - T}></rect>
        </clipPath>
      </defs>

      <g class="pdots">
        {dots.map((d) => <circle cx={d.cx} cy={d.cy} r="0.9" />)}
      </g>

      <g class="texture" clip-path="url(#plot-box)">
        {fan.map((f) => <line x1={L} y1={B} x2={f.x2} y2={f.y2} />)}
        {
          [90, 170, 250, 330].map((r) => (
            <path d={`M${L + r} ${B} A${r} ${r} 0 0 0 ${L} ${B - r}`} />
          ))
        }
      </g>

      <path class="axis" d={`M${L} ${B} H${R}`}></path>
      <path class="axis" d={`M${L} ${B} V${T}`}></path>
      <path
        class="axis"
        d={`M${L} ${T + 22} V${T} H${L + 22} M${R - 22} ${T} H${R} V${T + 22} M${R} ${B - 22} V${B}`}
      ></path>

      <g class="atk">
        {
          ticks.map((t) => (
            <>
              <line
                x1={px(t.v)}
                y1={B}
                x2={px(t.v)}
                y2={B + (t.major ? 9 : 4)}
              />
              <line
                x1={L}
                y1={py(t.v)}
                x2={L - (t.major ? 9 : 4)}
                y2={py(t.v)}
              />
            </>
          ))
        }
      </g>

      <g class="guide">
        {
          ordered.map((r) => (
            <>
              <path d={`M${r.X} ${r.Y} V${B}`} />
              <path d={`M${r.X} ${r.Y} H${L}`} />
            </>
          ))
        }
      </g>

      <g class="leaders">
        {ordered.map((r) => <path d={r.p.leader} data-leader={r.entry.id} />)}
      </g>

      <g class="pts">
        {
          ordered.map((r) => (
            <g
              class="pt"
              data-point={r.entry.id}
              transform={`translate(${r.X},${r.Y})`}
            >
              <circle class="ring2" r="21" />
              <circle class="halo" r="14" />
              <circle class="core" r="4.2" />
              <path class="halo" d="M-22 0H-17M17 0h5M0 -22v5M0 17v5" />
              <text x="20" y="-14">
                {r.n}
              </text>
            </g>
          ))
        }
      </g>

      <g class="labels">
        <text x={L} y={B + 22}>Systems / C++</text>
        <text x={R} y={B + 22} text-anchor="end">Scripted / TS</text>
        <text x={(L + R) / 2} y={B + 40} text-anchor="middle">
          Axis X — runtime
        </text>
        <text transform={`translate(${L - 12},${B}) rotate(-90)`}>
          Tooling &amp; data
        </text>
        <text
          transform={`translate(${L - 12},${T}) rotate(-90)`}
          text-anchor="end"
        >
          Geometry &amp; motion
        </text>
        <text
          transform={`translate(${L - 28},${(T + B) / 2}) rotate(-90)`}
          text-anchor="middle"
        >
          Axis Y — subject
        </text>
      </g>
    </svg>

    {
      ordered.map((r) => (
        <p
          class="co"
          style={r.p.co}
          data-callout={r.entry.id}
          aria-hidden="true"
        >
          <span class="co-n p-u">
            <b>[{r.n}]</b>
            <span>
              X {r.p.x.toFixed(2)} / Y {r.p.y.toFixed(2)}
            </span>
          </span>
          <span class="co-name">{r.entry.data.name}</span>
        </p>
      ))
    }
  </div>

  <div class="field">
    {
      ordered.map(({ entry, p, n }) => (
        <article
          class={`spec spec--${p.size}`}
          style={p.cell}
          data-spec={entry.id}
        >
          <figure>
            <ProjectFigure slug={entry.id} />
          </figure>
          <p class="idx" aria-hidden="true">
            {n}
          </p>
          <h3>
            <a href={`/projects/${entry.id}/`}>{entry.data.name}</a>
          </h3>
          <p class="p-u coord">
            X {p.x.toFixed(2)} / Y {p.y.toFixed(2)}
          </p>
          <p class="cap">{entry.data.tagline}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .work {
    margin-bottom: var(--loose);
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .sec-head .p-scale {
    flex: 1 1 60px;
    min-width: 40px;
    align-self: center;
    position: relative;
    top: -2px;
  }

  .work-note {
    max-width: 54ch;
  }

  /* The words that only hold while the plot is on screen. Below the wide
     layout the field is gone, so the heading stops calling the work plotted
     and the tag stops claiming a range of sizes there is no longer room to
     show. Off by default, earned by width. */
  .plotted {
    display: none;
  }

  @media (min-width: 68rem) {
    .plotted {
      display: inline;
    }
  }

  /* --- the field map ------------------------------------------------------ */

  .field-map {
    position: relative;
    margin-top: 34px;
  }

  .plot {
    width: 100%;
    height: auto;
  }

  .plot text {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    fill: var(--muted);
    text-transform: uppercase;
  }

  .plot .axis {
    stroke: var(--muted);
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .plot .atk line {
    stroke: var(--hair);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .plot .pdots circle {
    fill: var(--hair);
    opacity: 0.55;
  }

  .plot .texture line,
  .plot .texture path {
    stroke: var(--hair);
    fill: none;
    stroke-width: 1;
    opacity: 0.38;
    vector-effect: non-scaling-stroke;
  }

  .plot .guide path {
    stroke: var(--hair);
    stroke-dasharray: 1 5;
    fill: none;
    stroke-width: 1;
    opacity: 0.75;
    vector-effect: non-scaling-stroke;
  }

  .plot .leaders path {
    stroke: var(--hair);
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: stroke 0.2s ease;
  }

  .plot .halo {
    fill: none;
    stroke: var(--hair);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .plot .core {
    fill: var(--ink);
  }

  .plot .ring2 {
    opacity: 0;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: opacity 0.2s ease;
  }

  .plot .pt text {
    font-size: 11px;
    fill: var(--ink);
    letter-spacing: 0.12em;
  }

  /* Lit state, driven from either end. */
  .plot .pt.on .halo {
    stroke: var(--ink);
  }

  .plot .pt.on .ring2 {
    opacity: 1;
  }

  .plot .leaders path.on {
    stroke: var(--ink);
  }

  /* --- the callouts ------------------------------------------------------- */

  .co {
    position: absolute;
    display: grid;
    gap: 5px;
  }

  .co-n {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-bottom: 5px;
    border-bottom: var(--rule) solid var(--hair);
  }

  .co-n b {
    font-weight: 400;
    color: var(--ink);
    letter-spacing: 0.14em;
  }

  .co-n > span {
    margin-left: auto;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  /* Right-aligned callouts read outward from the plot, so their row reverses. */
  .co[style*="right:"] .co-n {
    flex-direction: row-reverse;
  }

  .co[style*="right:"] .co-n > span {
    margin-left: 0;
    margin-right: auto;
  }

  .co-name {
    font-size: 17px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .co.on .co-name {
    color: var(--ink);
  }

  @media (min-width: 68rem) {
    .field-map {
      aspect-ratio: 1000 / 640;
      max-width: 1160px;
    }
    .plot {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
  }

  /* Narrower than the callouts' room, the field goes rather than shrinks. Its
     labels are sized in viewBox units, so a plot scaled to a phone sets its own
     lettering at four pixels — it stops being a diagram and becomes a picture
     of one. The specimens below say the same thing at a size that survives, and
     the coordinates go with the plot: a cross-reference to a field that is not
     on screen refers to nothing. */
  @media (max-width: 68rem) {
    .field-map,
    .work-note,
    .spec .coord {
      display: none;
    }
  }

  /* --- the specimen field ------------------------------------------------- */

  .field {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gut);
    row-gap: 0;
    margin-top: var(--loose);
  }

  .field > * {
    min-width: 0;
  }

  .spec {
    display: flex;
    flex-direction: column;
    gap: 4px;
    /* Containing block for the stretched link below. */
    position: relative;
  }

  .spec figure {
    margin: 0 0 6px;
  }

  /* These carry wide enough cells to be drawn past the small-plate ceiling. The
     line work is non-scaling, so a drawing gains size without gaining weight —
     it reads as a larger plate, not a heavier one. Its lettering does scale
     though, which is what sets each ceiling: the labels are the first thing to
     get too loud, well before the cell runs out of room. */
  .spec[data-spec="study-companion"] {
    --fig-cap: 420px;
  }

  /* Drawn at nearly twice the size it was authored at, so its type is authored
     back down by the same factor — the device gets the room, its labels do not
     inherit the promotion. */
  .spec[data-spec="cipherbound"] {
    --fig-cap: 560px;
    --ins-type: 6.7px;
    /* How long the shell takes to fall shut. The rim waits exactly this long
       before it stops being inked, so the two have to be one number. */
    --cb-close: 0.26s;
  }

  .spec[data-spec="game-of-life"] {
    --fig-cap: 360px;
  }

  .spec .idx {
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px var(--hair);
    transition:
      color 0.25s ease,
      -webkit-text-stroke-color 0.25s ease;
    font-variant-numeric: tabular-nums;
  }

  .spec h3 {
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.02;
    margin-top: 8px;
  }

  .spec h3 a {
    text-decoration: none;
    background-image: linear-gradient(var(--ink), var(--ink));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.34s cubic-bezier(0.2, 0.7, 0.2, 1);
    padding-bottom: 2px;
  }

  /* The whole specimen answers to the pointer — the rule draws itself, the
     numeral inks, the device opens — so the whole specimen has to be the
     target. Anything that moves under the cursor and then refuses the click is
     a broken promise. One anchor still carries the link: it is stretched over
     its specimen rather than duplicated, so the accessibility tree keeps
     exactly one entry per project, named by the heading. */
  .spec h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .spec:hover h3 a,
  .spec:focus-within h3 a {
    background-size: 100% 1px;
  }

  .spec:hover .idx,
  .spec:focus-within .idx {
    color: var(--ink);
    -webkit-text-stroke-color: var(--ink);
  }

  .spec:hover :global(.ins .node),
  .spec:focus-within :global(.ins .node) {
    fill: var(--ink);
  }

  /* The capture device opens a little when its specimen is hovered. The pivot
     is the hinge pin itself, in viewBox units, so the shell swings on the part
     the drawing says it swings on. Eight degrees is enough to break the seam
     and show the cavity behind it without the figure becoming a cartoon.

     Opening and closing are not the same motion, because a sprung lid is not
     eased shut — it is let go. So the return is the shorter, harder curve, and
     the rule below states it: the resting declaration is the close, and hover
     overrides it with the longer, softer one it opens on. */
  .spec :global(.cb-lid) {
    transform-box: view-box;
    transform-origin: 44.3px 128px;
    transition: transform var(--cb-close) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spec:hover :global(.cb-lid),
  .spec:focus-within :global(.cb-lid) {
    transform: rotate(-8deg);
    transition-duration: 0.5s;
    transition-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* The rim that closes the shell. Closed, it lies exactly along the band and
     over the release, and inking it there on top of them would put a heavier
     line on the top of the band than on the bottom — on a sheet drawn at one
     line weight throughout, that reads. So it is only inked while the shell is
     off the band: in at the instant the swing starts, while it is still
     coincident and so cannot be seen to arrive, and out again only once the
     shell has landed back on it. */
  .spec :global(.cb-rim) {
    stroke-opacity: 0;
    transition: stroke-opacity 0s linear var(--cb-close);
  }

  .spec:hover :global(.cb-rim),
  .spec:focus-within :global(.cb-rim) {
    stroke-opacity: 1;
    transition-delay: 0s;
  }

  /* --- Study Companion: the build runs -------------------------------------
     A read head passes down the authored rows, the compile fires behind it,
     and the four pages ink one at a time. Nothing here is a progress bar
     pretending to measure something: the whole pass is under four tenths of a
     second, which is short enough to read as an answer rather than as work
     being done in front of you.

     All of it is declared on hover rather than on a class, so it is one
     animation per element with no state to keep and no script at all. */
  .spec:hover :global(.sc-row),
  .spec:focus-within :global(.sc-row) {
    animation: sc-sweep 0.15s linear;
    animation-delay: calc(var(--i) * 0.022s);
  }

  @keyframes sc-sweep {
    0% {
      stroke: var(--hair);
    }
    45% {
      stroke: var(--ink);
    }
    100% {
      stroke: var(--hair);
    }
  }

  .spec :global(.sc-dot) {
    transform-box: fill-box;
    transform-origin: center;
  }

  .spec:hover :global(.sc-dot),
  .spec:focus-within :global(.sc-dot) {
    animation: sc-pop 0.19s cubic-bezier(0.3, 0.8, 0.3, 1);
    animation-delay: 0.2s;
  }

  @keyframes sc-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(2.1);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Leaving is not the same motion as arriving: the pages ink one at a time
     because that is the build, but they go back to paper together. Both the
     rows and the pages keep .h, so the drawing is a correct plate on its own
     and this file only says what happens to it under a pointer. */
  .spec :global(.sc-plate) {
    transition: stroke 0.2s ease;
  }

  .spec:hover :global(.sc-plate),
  .spec:focus-within :global(.sc-plate) {
    stroke: var(--ink);
    transition-duration: 0.1s;
    transition-delay: calc(0.24s + var(--i) * 0.05s);
  }

  /* The count. Four readouts on the same baseline, of which only the last is
     inked at rest; hovering hides that one for as long as the build takes and
     hands the line to 01, 02 and 03 in turn. Each is shown by an animation
     with no fill mode, so when it ends the element simply returns to whatever
     the resting rule says — which is the whole trick. */
  .spec :global(.sc-count) {
    opacity: 0;
  }

  .spec :global(.sc-count--4) {
    opacity: 1;
  }

  .spec:hover :global(.sc-count--1),
  .spec:focus-within :global(.sc-count--1) {
    animation: sc-show 0.05s step-end 0.24s;
  }

  .spec:hover :global(.sc-count--2),
  .spec:focus-within :global(.sc-count--2) {
    animation: sc-show 0.05s step-end 0.29s;
  }

  .spec:hover :global(.sc-count--3),
  .spec:focus-within :global(.sc-count--3) {
    animation: sc-show 0.05s step-end 0.34s;
  }

  .spec:hover :global(.sc-count--4),
  .spec:focus-within :global(.sc-count--4) {
    animation: sc-hold 0.39s step-end;
  }

  @keyframes sc-show {
    from,
    to {
      opacity: 1;
    }
  }

  @keyframes sc-hold {
    from,
    to {
      opacity: 0;
    }
  }

  /* --- NTNU API: a request travels -----------------------------------------
     Eight requests ride the leaders already on the plate, leave on their own
     schedules, and converge. The hub answers once they are in, and one request
     leaves again on the MCP line — the surface the project exists for, which
     is why it is the one that carries the reply.

     `--i` is the departure in milliseconds, authored per source in the figure.
     The packets rest invisible and the keyframes fade them in and out, so with
     the animation gone they leave nothing behind. */
  .spec :global(.na-pkt) {
    fill: var(--ink);
    opacity: 0;
    offset-rotate: 0deg;
  }

  .spec:hover :global(.na-pkt),
  .spec:focus-within :global(.na-pkt) {
    animation: na-ride 0.34s cubic-bezier(0.4, 0, 0.35, 1);
    animation-delay: calc(var(--i, 0) * 1ms);
  }

  .spec :global(.na-pkt--out) {
    --i: 420;
  }

  @keyframes na-ride {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  /* A source inks as its own request leaves it, not when the pointer arrives,
     so the column lights unevenly — which is the point being made. */
  .spec :global(.na-src) {
    transition: fill 0.2s ease;
  }

  .spec:hover :global(.na-src),
  .spec:focus-within :global(.na-src) {
    fill: var(--ink);
    transition-delay: calc(var(--i) * 1ms);
  }

  .spec :global(.na-hub) {
    transform-box: fill-box;
    transform-origin: center;
  }

  .spec:hover :global(.na-hub),
  .spec:focus-within :global(.na-hub) {
    animation: na-pulse 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.42s;
  }

  @keyframes na-pulse {
    0% {
      transform: scale(1);
      stroke: var(--hair);
    }
    45% {
      transform: scale(1.22);
      stroke: var(--ink);
    }
    100% {
      transform: scale(1);
      stroke: var(--hair);
    }
  }

  /* --- Black hole: the captured ray ----------------------------------------
     The ray itself is drawn in by scripts/capture.ts, which has to own it:
     the sheet's strokes are non-scaling, and that puts dash arithmetic in
     screen space while every length the DOM will tell you about is in viewBox
     units. All that is left here is the label, which is hidden with the ray it
     names and arrives once the ray is well past the photon ring — a threshold
     announced before anything has crossed it is a caption, not a reading. */
  .spec :global([data-capture="live"] .bh-caplbl) {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .spec:hover :global([data-capture="live"] .bh-caplbl),
  .spec:focus-within :global([data-capture="live"] .bh-caplbl) {
    opacity: 1;
    transition-delay: 0.26s;
  }

  /* kernel.css already collapses every duration for a visitor who has asked
     for less motion, but it leaves the delays alone — and a sequence is still
     a sequence when each step is instant and the steps are staggered over four
     tenths of a second. These are the only staggers on the sheet, so they are
     cleared here rather than globally. */
  @media (prefers-reduced-motion: reduce) {
    .spec :global(.sc-row),
    .spec :global(.sc-dot),
    .spec :global(.sc-plate),
    .spec :global(.sc-count),
    .spec :global(.na-pkt),
    .spec :global(.na-src),
    .spec :global(.na-hub) {
      animation-delay: 0s !important;
      transition-delay: 0s !important;
    }
  }

  .spec .coord {
    margin-top: 6px;
  }

  .spec .cap {
    color: var(--muted);
    margin-top: 9px;
    max-width: 38ch;
    font-size: 14.5px;
    line-height: 1.42;
  }

  .spec--xl .idx {
    font-size: clamp(56px, 7vw, 102px);
  }
  .spec--xl h3 {
    font-size: clamp(26px, 3.1vw, 40px);
  }
  .spec--xl .cap {
    font-size: 16px;
    max-width: 40ch;
  }
  .spec--lg .idx {
    font-size: clamp(44px, 5vw, 74px);
  }
  .spec--lg h3 {
    font-size: clamp(22px, 2.5vw, 32px);
  }
  .spec--lg .cap {
    font-size: 15.5px;
  }
  .spec--md .idx {
    font-size: clamp(34px, 3.6vw, 52px);
  }
  .spec--md h3 {
    font-size: clamp(18px, 1.9vw, 24px);
  }
  .spec--sm .idx {
    font-size: clamp(28px, 3vw, 40px);
  }
  .spec--sm h3 {
    font-size: clamp(16px, 1.7vw, 20px);
  }
  .spec--sm .cap {
    font-size: 13.5px;
    max-width: 32ch;
  }

  /* Stacked, the tiers say nothing. A specimen is only "xl" relative to a "sm"
     sitting next to it, and in one column there is no next to it — the sizes
     would just read as inconsistency. So the weights collapse to one. */
  @media (max-width: 68rem) {
    .field {
      display: flex;
      flex-direction: column;
      gap: var(--loose);
    }
    .spec {
      margin-top: 0 !important;
      /* Every plate off its ceiling, so all five drawings fill the same box. */
      --fig-cap: 420px;
    }
    .spec figure {
      max-width: min(420px, 88vw);
    }
    .spec .idx {
      font-size: clamp(40px, 11vw, 64px);
    }
    .spec h3 {
      font-size: clamp(22px, 5.6vw, 30px);
    }
    .spec .cap {
      font-size: 15px;
      max-width: 38ch;
    }
  }
</style>

<script>
  /* Bind each specimen to its point, its leader and its callout, so the three
     light together from either end. */
  const specs = document.querySelectorAll<HTMLElement>("[data-spec]");

  for (const spec of specs) {
    const id = spec.dataset.spec!;
    const parts = [
      document.querySelector(`[data-point="${id}"]`),
      document.querySelector(`[data-leader="${id}"]`),
      document.querySelector(`[data-callout="${id}"]`),
    ].filter(Boolean) as Element[];

    const on = () => parts.forEach((p) => p.classList.add("on"));
    const off = () => parts.forEach((p) => p.classList.remove("on"));

    spec.addEventListener("mouseenter", on);
    spec.addEventListener("mouseleave", off);
    spec.addEventListener("focusin", on);
    spec.addEventListener("focusout", off);
  }
</script>
