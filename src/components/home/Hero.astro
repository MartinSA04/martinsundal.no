---
/**
 * Plate 01 — Subject.
 *
 * Rebuilt so the large elements are couplings rather than boxes with marks in
 * them. The name carries a rule cut to its own width; the lead runs inside a
 * chamfered aperture that bounds it; the settle state is a track that routes
 * the run's own readouts.
 *
 * Every number is computed at build time from the same plan file and the same
 * pure functions the browser runs, so the page is correct before any script
 * executes and the static values cannot drift. Stepping all 276 generations of
 * the 356x192 board costs about 110ms.
 */
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { parsePlan, step, countLive } from "../../lib/life.ts";
import Figure from "../micro/Figure.astro";
import Dial from "../micro/Dial.astro";
import Trace from "../micro/Trace.astro";
import Readout from "../micro/Readout.astro";
import Ruler from "../micro/Ruler.astro";
import Racetrack from "../micro/Racetrack.astro";

const planPath = fileURLToPath(
  new URL("../../../public/martin_plan.txt", import.meta.url),
);
const plan = parsePlan(readFileSync(planPath, "utf8"));

const population: number[] = [countLive(plan.cells)];
let cells = plan.cells;
let settledGen = 0;

for (let g = 1; g <= 1000; g++) {
  const next = step(cells, plan.width, plan.height);
  let same = true;
  for (let i = 0; i < next.length; i++) {
    if (next[i] !== cells[i]) {
      same = false;
      break;
    }
  }
  if (same) {
    settledGen = g - 1;
    break;
  }
  cells = next;
  population.push(countLive(cells));
}

const settledPop = population[population.length - 1]!;
const TRACE_WINDOW = 120;
const traceSeries = population.slice(-TRACE_WINDOW);
const BOARD = `${plan.width}×${plan.height}`;
---

<section class="hero">
  <div class="wrap">
    <div class="plate-head">
      <Figure name="starburst" size={64} />
      <span class="micro-label">Subject</span>
      <span class="head-rule" aria-hidden="true"></span>
      <span class="micro-label plate-id">Plate 01</span>
    </div>

    {
      /* The name and the rule beneath it are one object: the wrapper is
        max-content, so the rule and the coordinates are exactly as wide as the
        name that produced them. No measuring pass, no magic number. */
    }
    <div class="nameplate">
      <h1 class="name">Martin Sundal Aspås</h1>
      <span class="name-rule" aria-hidden="true"></span>
      <div class="name-foot" aria-hidden="true">
        <span>63.43°N</span>
        <span>Trondheim · NO</span>
        <span>10.40°E</span>
      </div>
    </div>

    {
      /* The board settles into the word MARTIN at generation 276 and is a
      still life from there on. Board coordinates are fixed by
      martin_plan.txt: the settled word occupies x 21-79% of a 356x192 board.
      Overscaling the canvas to 166% and cropping puts the word's own width on
      the heading's measure, so the two line up as one block. */
    }
    <div class="figure">
      <div class="figure-rows">
        <Ruler axis="y" from={0} to={plan.height} majors={3} minors={2} />
      </div>

      <div class="life-frame" aria-hidden="true">
        <canvas id="life-canvas" width={plan.width} height={plan.height}
        ></canvas>
      </div>

      <div class="figure-cols">
        <Ruler axis="x" from={0} to={plan.width} majors={5} />
      </div>
    </div>

    <div class="instruments" aria-hidden="true">
      <Dial
        value={settledGen}
        max={settledGen}
        label="Gen"
        key="generation"
        size={112}
      />

      <div class="instruments-stack">
        <Trace
          points={traceSeries}
          label="Pop"
          value={String(settledPop)}
          key="population"
          width={148}
        />
        <Readout
          pairs={[
            { label: "Rule", value: "B3/S23" },
            { label: "Seed", value: "martin_plan.txt" },
          ]}
        />
      </div>

      <span class="instruments-state" data-life-state>
        <Racetrack
          label="Settled"
          top={`Gen ${settledGen}`}
          bottom={BOARD}
          signal
        />
      </span>
    </div>
  </div>

  {
    /* No aperture here. One shape-bounded block on a page reads as a
      deliberate accent; two read as a tic, and this copy is supporting
      material rather than the statement. It is coupled the way the rest of
      the plate is instead: a rule broken by its own label, and a measure that
      stops where the readout beside it begins. */
  }
  <div class="wrap summary">
    <div class="summary-axis" aria-hidden="true">
      <span class="summary-cap"></span>
      <span class="summary-rule"></span>
      <span class="micro-label">Summary</span>
      <span class="summary-rule"></span>
      <span class="summary-cap" data-at="end"></span>
    </div>

    <div class="summary-cols">
      <p class="lead">
        At Aker Solutions I work on the software behind a robotised production
        line: robot control, scanning, and the plumbing that moves data between
        them. The line welds, blasts and paints steel, so most of the work is
        making machines agree about where things are.
      </p>
      <p class="lead">
        I study applied physics and mathematics at NTNU. The projects below are
        what I do to learn a thing properly — writing a game engine taught me
        more about architecture than reading about it, and a renderer that bends
        light forces you to get the geometry right.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2) var(--space-5);
  }

  /* --- plate head --------------------------------------------------------- */
  .plate-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .head-rule {
    flex: 1;
    block-size: var(--rule);
    background: var(--hair);
  }

  .plate-id {
    color: var(--sig);
  }

  /* --- the nameplate ------------------------------------------------------ */
  .nameplate {
    display: grid;
    /* The rule and the readout below can only be the name's width if the
       wrapper is sized by its widest child, which is the name. */
    inline-size: max-content;
    max-inline-size: 100%;
    gap: 0.5rem;
    margin-block: var(--space-3) var(--space-2);
  }

  .name {
    font-size: clamp(2.3rem, 1rem + 7.2vw, 7.8rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin: 0;
  }

  .name-rule {
    block-size: var(--rule);
    background: var(--ink);
  }

  .name-foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* --- the life figure ----------------------------------------------------- */
  .figure {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "rows band"
      ".    cols";
    column-gap: var(--space-1);
    margin-block: var(--space-3) var(--space-2);
  }

  .figure-rows {
    grid-area: rows;
  }

  .figure-cols {
    grid-area: cols;
    margin-top: 4px;
  }

  .life-frame {
    grid-area: band;
    position: relative;
    width: 100%;
    aspect-ratio: 4;
    overflow: hidden;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  /* The word's centre is at 49.9% x and 49.7% y of the board, so centring on
     both axes lands it in the frame without a magic offset.

     The settled word is 206 of the board's 356 columns, so 166% puts it at
     96% of the frame: 1.66 * 206/356 = 0.96. */
  #life-canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 166%;
    /* The kernel reset caps media at 100%, which would silently undo the
       overscale the crop depends on. */
    max-width: none;
    height: auto;
    aspect-ratio: 356 / 192;
    image-rendering: pixelated;
  }

  /* --- instruments --------------------------------------------------------- */
  .instruments {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-2);
  }

  .instruments-stack {
    display: grid;
    gap: 0.2rem;
  }

  .instruments-state {
    margin-inline-start: auto;
  }

  /* --- summary ------------------------------------------------------------- */
  .summary {
    margin-top: var(--space-5);
  }

  /* The rule is broken by its label rather than the label sitting on top of
     an unbroken one, and it closes on caps at both ends. */
  .summary-axis {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .summary-rule {
    flex: 1;
    block-size: var(--rule);
    background: var(--hair);
  }

  .summary-cap {
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    border: var(--rule) solid var(--hair);
    flex: none;
  }

  .summary-cap[data-at="end"] {
    background: var(--hair);
  }

  .summary-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .lead {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 52ch;
  }

  @media (max-width: 60rem) {
    .instruments-state {
      margin-inline-start: 0;
    }
  }

  @media (max-width: 46rem) {
    .nameplate {
      inline-size: 100%;
    }
    .figure {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "band"
        "cols";
    }
    /* The row axis needs horizontal room the phone layout does not have, and
       the column axis already establishes the board's scale. */
    .figure-rows {
      display: none;
    }
    .life-frame {
      aspect-ratio: 3;
    }
    .summary-cols {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>

<script>
  import { createLifeScene } from "../../lib/life.ts";

  const canvas = document.getElementById("life-canvas");
  const dial = document.querySelector<HTMLElement>('[data-dial="generation"]');
  const dialArc = dial?.querySelector<SVGCircleElement>("[data-dial-arc]");
  const dialValue = dial?.querySelector<HTMLElement>("[data-dial-value]");
  const trace = document.querySelector<HTMLElement>(
    '[data-trace="population"]',
  );
  const traceLine =
    trace?.querySelector<SVGPolylineElement>("[data-trace-line]");
  const traceValue = trace?.querySelector<HTMLElement>("[data-trace-value]");
  const state = document.querySelector<HTMLElement>("[data-life-state]");

  /* The dial ships rendered at the settled generation so the page is correct
     with script off. Once script runs it is driving a live simulation from
     zero, so the settle mark is cleared and re-earned. */
  const MAX_GEN = Number(dialValue?.textContent?.trim() ?? 276) || 276;
  const WINDOW = 120;

  const series: number[] = [];

  /* The trace ships rendered from the build-time population history. Two paths
     must not clobber it: under reduced motion the scene reports once, already
     settled, so the static trace IS the finished history; and while animating,
     a series of one sample projects to a single point, which draws no line. */
  let ownsTrace = false;

  /* Mirrors the projection in Trace.astro. The two must agree or the trace
     would jump the moment the first live sample replaced the static one. */
  function project(values: number[], w: number, h: number): string {
    if (values.length === 0) return "";
    const lo = Math.min(...values);
    const hi = Math.max(...values);
    const span = hi - lo;
    const stepX = values.length > 1 ? w / (values.length - 1) : 0;
    return values
      .map((n, i) => {
        const y = span === 0 ? h - 1 : h - 1 - ((n - lo) / span) * (h - 2);
        return `${(i * stepX).toFixed(2)},${y.toFixed(2)}`;
      })
      .join(" ");
  }

  if (canvas instanceof HTMLCanvasElement) {
    const width = Number(trace?.dataset.width ?? 148);
    const height = Number(trace?.dataset.height ?? 28);

    const trackLabel = state?.querySelector<HTMLElement>("[data-track-label]");
    const trackTop = state?.querySelector<HTMLElement>("[data-track-top]");
    const track = state?.querySelector<HTMLElement>('[data-micro="racetrack"]');

    /* The marker is on the plate from the first frame. It ships settled —
       correct for a visitor with no script — and script demotes it to running
       before the board starts over, so the state is never claimed early and
       never absent. */
    if (trackLabel) trackLabel.textContent = "Running";
    if (track) track.removeAttribute("data-signal");

    const scene = createLifeScene({
      canvas,
      planSrc: "/martin_plan.txt",
      // 276 generations at 24/s lands in about eleven seconds, and the board
      // is a still life from there on.
      speed: 24,
      pauseWhenOffscreen: true,
      onGeneration(generation, settled, pop) {
        if (dialValue) {
          dialValue.textContent = String(generation).padStart(3, "0");
        }
        if (dialArc) {
          const pct = Math.min(100, (generation / MAX_GEN) * 100);
          dialArc.setAttribute("stroke-dashoffset", String(100 - pct));
        }

        if (trackTop) trackTop.textContent = `Gen ${generation}`;
        if (trackLabel)
          trackLabel.textContent = settled ? "Settled" : "Running";
        if (track) {
          if (settled) track.setAttribute("data-signal", "");
          else track.removeAttribute("data-signal");
        }

        // A first report that is already settled is the reduced-motion path:
        // leave the rendered history alone.
        if (series.length === 0 && settled) return;

        series.push(pop);
        if (series.length > WINDOW) series.shift();
        if (series.length >= 2) ownsTrace = true;

        if (traceLine && ownsTrace) {
          traceLine.setAttribute("points", project(series, width, height));
        }
        if (traceValue) traceValue.textContent = String(pop);
      },
    });
    scene?.start();
  }
</script>
