---
import Rule from "../micro/Rule.astro";
import SpecBlock from "../micro/SpecBlock.astro";
---

<section class="hero">
  <div class="wrap">
    <Rule label="Idx_00 / Trondheim · NO" />
    <h1 class="name">Martin Sundal Aspås</h1>

    {
      /* The board settles into the word MARTIN at generation 277 and is a still
      life from there on. It used to carry the name alone, with the real text
      visually-hidden — which meant the name did not exist for the first five
      seconds, or in any screenshot. The heading above says it immediately and
      the simulation signs it.

      Board coordinates are fixed by martin_plan.txt: the settled word occupies
      x 21-79% and y 40-59% of a 356x192 board. Overscaling the canvas to 173%
      and cropping puts the word's own width exactly on the heading's measure,
      so the two line up as one block. */
    }
    <div class="life-frame" aria-hidden="true">
      <canvas id="life-canvas" width="356" height="192"></canvas>
    </div>

    {
      /* The board takes about eleven seconds to spell the name, and without
      this the band is undifferentiated static for all of them, with nothing
      saying a simulation is running. aria-hidden: the h1 above already states
      the name, and a screen reader has no use for a generation counter. */
    }
    <p class="micro-label life-readout" data-life-readout aria-hidden="true">
      GEN 000 · B3/S23 · 356×192
    </p>
  </div>

  <div class="wrap hero-foot">
    <p class="lead">
      I write software for things that move or compute. That covers robotics,
      simulation and industrial software at Aker Solutions, plus a steady stream
      of side projects.
    </p>

    <SpecBlock
      rows={[
        { label: "Role", value: "Software engineer" },
        { label: "At", value: "Aker Solutions, Verdal" },
        { label: "Studying", value: "Applied physics & maths, NTNU" },
      ]}
    />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-4) var(--space-6);
  }

  /* Sized to run the full measure rather than sit in a column: at 1280 this
     lands a hair under the 78rem wrap. */
  .name {
    font-size: clamp(2.6rem, 1.2rem + 8vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin-block: var(--space-3) 0;
    text-wrap: balance;
  }

  .life-frame {
    /* Cropped to a band roughly 1.6x the settled word's height, so the word
       reads as a slab rather than floating in empty substrate. */
    --board-aspect: 356 / 192;
    position: relative;
    width: 100%;
    aspect-ratio: 3.45;
    overflow: hidden;
    margin-block: var(--space-2) var(--space-1);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  /* The word's centre is at 49.9% x and 49.7% y of the board, so centring on
     both axes lands it in the frame without a magic offset.

     The settled word is 206 of the board's 356 columns, so 166% puts it at
     96% of the frame: 1.66 * 206/356 = 0.96. It used to be 173%, which put it
     at 100.1% and cut the outer column off the M and the N. */
  #life-canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 166%;
    /* The kernel reset caps media at 100%, which would silently undo the
       overscale the crop depends on. */
    max-width: none;
    height: auto;
    aspect-ratio: var(--board-aspect);
    image-rendering: pixelated;
  }

  .life-readout {
    display: block;
    margin-bottom: var(--space-5);
    font-variant-numeric: tabular-nums;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .lead {
    max-width: 42ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  @media (max-width: 46rem) {
    .hero-foot {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .life-frame {
      aspect-ratio: 3;
    }
  }
</style>

<script>
  import { createLifeScene } from "../../lib/life.ts";

  const canvas = document.getElementById("life-canvas");
  const readout = document.querySelector("[data-life-readout]");

  if (canvas instanceof HTMLCanvasElement) {
    const scene = createLifeScene({
      canvas,
      planSrc: "/martin_plan.txt",
      // 276 generations at the old 10/s took 28 seconds to spell the name,
      // which meant in practice nobody ever saw it resolve. At 24/s it lands
      // in about 11, and the board is a still life from there on.
      speed: 24,
      pauseWhenOffscreen: true,
      onGeneration(generation, settled) {
        if (!readout) return;
        const n = String(generation).padStart(3, "0");
        readout.textContent = settled
          ? `GEN ${n} · STILL LIFE`
          : `GEN ${n} · B3/S23 · 356×192`;
      },
    });
    scene?.start();
  }
</script>
