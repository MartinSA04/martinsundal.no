---
import Rule from "../micro/Rule.astro";

const links = [
  {
    label: "Email",
    value: "martin.s.aspas@gmail.com",
    href: "mailto:martin.s.aspas@gmail.com",
  },
  {
    label: "LinkedIn",
    value: "martinsa04",
    href: "https://linkedin.com/in/martinsa04",
  },
  {
    label: "GitHub",
    value: "MartinSA04",
    href: "https://github.com/MartinSA04",
  },
  {
    label: "npm",
    value: "~martinsa04",
    href: "https://www.npmjs.com/~martinsa04",
  },
];
---

<section id="contact" class="contact card">
  <div class="wrap">
    <Rule label="Idx_04 / Contact" />
    <ul>
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              rel={l.href.startsWith("http") ? "me noopener" : undefined}
            >
              <span class="micro-label">{l.label}</span>
              <span class="value">{l.value}</span>
              <span class="arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-6) var(--space-7);
  }

  /* Two by two rather than a fifth stack of full-width rows. The page has just
     run five project rows and four more of the same shape read as filler. */
  ul {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--rule);
    background: var(--hair);
    border: var(--rule) solid var(--hair);
  }

  li {
    background: var(--sub);
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-2);
    padding: var(--space-3);
    text-decoration: none;
    transition: background 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  a:hover {
    background: color-mix(in oklab, var(--sig) 8%, var(--sub));
  }

  .micro-label {
    grid-column: 1 / -1;
    margin-bottom: 0.4rem;
  }

  .value {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
    transition: color 0.25s ease;
  }

  a:hover .value {
    color: var(--sig);
  }

  .arrow {
    color: var(--muted);
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.25s ease;
  }

  a:hover .arrow {
    transform: translateX(4px);
    color: var(--sig);
  }

  @media (max-width: 40rem) {
    ul {
      grid-template-columns: 1fr;
    }
    .value {
      font-size: var(--step-0);
    }
  }
</style>
