---
import Mark from "../micro/Mark.astro";
import Icon from "../micro/Icon.astro";
import Tag from "../micro/Tag.astro";
import Figure from "../micro/Figure.astro";

const links = [
  {
    label: "Email",
    value: "martin.s.aspas@gmail.com",
    href: "mailto:martin.s.aspas@gmail.com",
    channel: "Direct",
  },
  {
    label: "LinkedIn",
    value: "martinsa04",
    href: "https://linkedin.com/in/martinsa04",
    channel: "Profile",
  },
  {
    label: "GitHub",
    value: "MartinSA04",
    href: "https://github.com/MartinSA04",
    channel: "Source",
  },
  {
    label: "npm",
    value: "~martinsa04",
    href: "https://www.npmjs.com/~martinsa04",
    channel: "Registry",
  },
];
---

<section id="contact" class="contact card">
  <div class="wrap">
    <Mark
      n={5}
      label="Contact"
      figure="target"
      note={`${links.length} channels`}
    />

    {
      /* The grid is a real hairline lattice — a --rule gap over a --hair
        background — and its centre is the one intersection the page makes on
        purpose. */
    }
    <div class="lattice">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                rel={l.href.startsWith("http") ? "me noopener" : undefined}
              >
                <span class="head">
                  <span class="micro-label">{l.label}</span>
                  <Tag variant="angle">{l.channel}</Tag>
                </span>
                <span class="value">{l.value}</span>
                <span class="arrow" aria-hidden="true">
                  <Icon name="arrow-right" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      {
        /* A registration target sized to the lattice, not a mark laid on top
          of it. Its crosshair arms run out past the ring and land exactly on
          the two hairline gaps, so the grid reads as continuing through the
          figure — the graphic is the intersection rather than a sticker over
          it. */
      }
      <span class="lattice-mark" data-lattice-mark
        ><Figure name="target" size={64} /></span
      >
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-4) var(--space-5);
  }

  .lattice {
    position: relative;
  }

  /* A wrapper rather than a class on <Figure>: scoped styles are keyed to
     elements this template declares, and a child component's root is not
     one. */
  .lattice-mark {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: block;
    line-height: 0;
    /* The substrate disc is load-bearing. The figure and the lattice both
       draw in hairline weight, so laid flat over the intersection the ring
       would vanish into the lines it crosses. Punching a round hole and
       setting the target inside it is what makes the arms read as continuing
       the grid instead of colliding with it. */
    padding: 0.5rem;
    background: var(--sub);
    border-radius: 50%;
    color: var(--ink);
    pointer-events: none;
  }

  /* Two by two rather than a fifth stack of full-width rows. The page has just
     run five project rows and four more of the same shape read as filler. */
  ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--rule);
    background: var(--hair);
  }

  li {
    background: var(--sub);
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-2);
    /* Generous, and load-bearing: the registration target sits on the shared
       corner of all four cells, so the content has to clear its radius or the
       figure lands on top of a handle. */
    padding: var(--space-3) var(--space-4) var(--space-4);
    text-decoration: none;
    transition: background 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  a:hover {
    background: color-mix(in oklab, var(--sig) 8%, var(--sub));
  }

  /* The channel tag sits opposite the label so each cell opens with a paired
     readout rather than a single word. */
  .head {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 0.4rem;
  }

  .value {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
    transition: color 0.25s ease;
  }

  a:hover .value {
    color: var(--sig);
  }

  .arrow {
    display: block;
    line-height: 0;
    color: var(--muted);
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.25s ease;
  }

  a:hover .arrow {
    transform: translateX(4px);
    color: var(--sig);
  }

  @media (max-width: 40rem) {
    ul {
      grid-template-columns: 1fr;
    }
    /* One column, so there is no intersection to mark. */
    .lattice-mark {
      display: none;
    }
    .value {
      font-size: var(--step-0);
    }
  }
</style>
