---
import Mark from "../micro/Mark.astro";
import Icon from "../micro/Icon.astro";
import Tag from "../micro/Tag.astro";
import Crosshair from "../micro/Crosshair.astro";

const links = [
  {
    label: "Email",
    value: "martin.s.aspas@gmail.com",
    href: "mailto:martin.s.aspas@gmail.com",
    channel: "Direct",
  },
  {
    label: "LinkedIn",
    value: "martinsa04",
    href: "https://linkedin.com/in/martinsa04",
    channel: "Profile",
  },
  {
    label: "GitHub",
    value: "MartinSA04",
    href: "https://github.com/MartinSA04",
    channel: "Source",
  },
  {
    label: "npm",
    value: "~martinsa04",
    href: "https://www.npmjs.com/~martinsa04",
    channel: "Registry",
  },
];
---

<section id="contact" class="contact card">
  <div class="wrap">
    <Mark
      n={5}
      label="Contact"
      figure="target"
      note={`${links.length} channels`}
    />

    {
      /* The grid is a real hairline lattice — a --rule gap over a --hair
        background — and its centre is the one intersection the page makes on
        purpose. Marking it is what the crosshair primitive is for. */
    }
    <div class="lattice">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                rel={l.href.startsWith("http") ? "me noopener" : undefined}
              >
                <span class="head">
                  <span class="micro-label">{l.label}</span>
                  <Tag variant="angle">{l.channel}</Tag>
                </span>
                <span class="value">{l.value}</span>
                <span class="arrow" aria-hidden="true">
                  <Icon name="arrow-right" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <span class="lattice-mark"><Crosshair size={18} /></span>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-4) var(--space-5);
  }

  .lattice {
    position: relative;
  }

  /* Sits on the intersection the two hairline gaps already make. A wrapper
     rather than a class on <Crosshair>: scoped styles are keyed to elements
     this template declares, and a child component's root is not one.

     The substrate padding is load-bearing. The crosshair draws in --hair and
     so does the lattice, so laid straight over the intersection it is exactly
     invisible. Punching a hole in the lines and setting the mark inside it is
     what makes it read as a registration mark rather than as nothing. */
  .lattice-mark {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: block;
    line-height: 0;
    padding: 0.55rem;
    background: var(--sub);
    pointer-events: none;
  }

  /* Two by two rather than a fifth stack of full-width rows. The page has just
     run five project rows and four more of the same shape read as filler. */
  ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--rule);
    background: var(--hair);
    border: var(--rule) solid var(--hair);
  }

  li {
    background: var(--sub);
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-2);
    padding: var(--space-3);
    text-decoration: none;
    transition: background 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  a:hover {
    background: color-mix(in oklab, var(--sig) 8%, var(--sub));
  }

  /* The channel tag sits opposite the label so each cell opens with a paired
     readout rather than a single word. */
  .head {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 0.4rem;
  }

  .value {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
    transition: color 0.25s ease;
  }

  a:hover .value {
    color: var(--sig);
  }

  .arrow {
    display: block;
    line-height: 0;
    color: var(--muted);
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.25s ease;
  }

  a:hover .arrow {
    transform: translateX(4px);
    color: var(--sig);
  }

  @media (max-width: 40rem) {
    ul {
      grid-template-columns: 1fr;
    }
    /* One column, so there is no intersection to mark. */
    .lattice-mark {
      display: none;
    }
    .value {
      font-size: var(--step-0);
    }
  }
</style>
