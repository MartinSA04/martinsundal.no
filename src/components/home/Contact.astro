---
/**
 * FIG. 05 — Contact.
 *
 * A knockout bar: four cells of reversed mono, one per channel. The heaviest
 * mark on the plate, and the last thing on it.
 */
const links = [
  {
    label: "Mail",
    value: "martin.s.aspas@gmail.com",
    href: "mailto:martin.s.aspas@gmail.com",
    wrap: true,
  },
  {
    label: "GitHub",
    value: "MartinSA04",
    href: "https://github.com/MartinSA04",
  },
  {
    label: "LinkedIn",
    value: "martinsa04",
    href: "https://linkedin.com/in/martinsa04",
  },
  {
    label: "npm",
    value: "~martinsa04",
    href: "https://www.npmjs.com/~martinsa04",
  },
];
---

<footer id="contact" class="zone contact" aria-labelledby="con-h">
  <div class="sec-head">
    <h2 id="con-h" class="p-u p-u--lg p-u--ink zh">Fig. 05 — Contact</h2>
    <span class="p-u p-tag">{links.length} channels</span>
    <span class="p-scale" aria-hidden="true"></span>
  </div>

  <div class="p-knock">
    {
      links.map((l) => (
        <p class="cell p-u">
          <span class="p-u--hair">{l.label}</span>
          <br />
          <a
            href={l.href}
            rel={l.href.startsWith("http") ? "me noopener" : undefined}
            style={l.wrap ? "word-break:break-all" : undefined}
          >
            {l.value}
          </a>
        </p>
      ))
    }
  </div>

  <div class="colophon">
    <span class="p-u p-u--hair"
      >Plate 001 · Martin Sundal Aspås · Trondheim</span
    >
    <span class="p-u p-u--hair">Drawn in SVG and CSS · no images</span>
  </div>
</footer>

<style>
  .contact {
    padding-bottom: var(--loose);
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .sec-head .p-scale {
    flex: 1 1 60px;
    min-width: 40px;
    align-self: center;
    position: relative;
    top: -2px;
  }

  .colophon {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
</style>
