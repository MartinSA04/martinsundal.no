---
/**
 * Plate 04 — Notes.
 *
 * The statement runs inside a vesica. It has no rectangle of its own: the
 * measure is widest on the centre line and closes to nothing at both
 * vertices, so the paragraph is the shape rather than a block sitting inside
 * one. This is the device the studies settled on, at the one place on the
 * page with a paragraph big enough to carry it.
 */
import Mark from "../micro/Mark.astro";
import Aperture from "../micro/Aperture.astro";
import Readout from "../micro/Readout.astro";
---

<section id="about" class="notes card">
  <div class="wrap">
    <Mark n={4} label="Notes" figure="tangent" />

    <Aperture variant="lens" aspect={0.155} minHalf={0.44}>
      <p class="statement">
        I build software for the physical world, where geometry and motion drive
        the design, and for the systems that have to keep running around it. A
        game engine written from scratch teaches more about architecture than
        any tutorial, and a renderer that bends light teaches the geometry it is
        modelling — so the side projects are not a portfolio, they are how the
        reading gets done.
      </p>
    </Aperture>

    <div class="foot">
      <Readout
        pairs={[
          { label: "Studying", value: "Applied physics & maths, NTNU" },
          { label: "Based", value: "Trondheim · NO" },
        ]}
      />
    </div>
  </div>
</section>

<style>
  .notes {
    padding-block: var(--space-4);
  }

  .statement {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
    text-align: center;
    text-wrap: pretty;
  }

  .foot {
    margin-top: var(--space-4);
    display: flex;
    justify-content: center;
  }

  @media (max-width: 46rem) {
    .statement {
      text-align: left;
      font-size: var(--step-0);
    }
    .foot {
      justify-content: flex-start;
    }
  }
</style>
