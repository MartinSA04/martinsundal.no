        <mask id="bandA">
          <circle cx="230" cy="200" r="132" fill="#fff" />
          <circle cx="230" cy="200" r="106" fill="#000" />
        </mask>
        <mask id="bandB">
          <circle cx="230" cy="200" r="158" fill="#fff" />
          <circle cx="230" cy="200" r="132" fill="#000" />
        </mask>
        <mask id="bandC">
