}

{
  slug === "game-of-life" && (
    <div class="matwrap">
      <div class="dotmat" role="presentation" />
      <svg
        class="ins"
        viewBox="0 0 220 118"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <g class="f">
          <rect x="16" y="5" width="7" height="7" />
          <rect x="27" y="16" width="7" height="7" />
          <rect x="5" y="27" width="7" height="7" />
          <rect x="16" y="27" width="7" height="7" />
          <rect x="27" y="27" width="7" height="7" />
          <rect x="82" y="49" width="7" height="7" />
          <rect x="93" y="60" width="7" height="7" />
          <rect x="71" y="71" width="7" height="7" />
          <rect x="82" y="71" width="7" height="7" />
          <rect x="93" y="71" width="7" height="7" />
          <rect x="159" y="27" width="7" height="7" />
          <rect x="170" y="27" width="7" height="7" />
          <rect x="159" y="38" width="7" height="7" />
          <rect x="170" y="38" width="7" height="7" />
          <rect x="192" y="82" width="7" height="7" />
          <rect x="203" y="82" width="7" height="7" />
          <rect x="192" y="93" width="7" height="7" />
          <rect x="203" y="93" width="7" height="7" />
        </g>
        <g class="d">
          <path d="M38 8L66 46M105 74L150 40" />
        </g>
      </svg>
    </div>
  )
}

<style>
  .matwrap {
    position: relative;
  }

  .matwrap svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dotmat {
    height: 118px;
    width: 100%;
    background-image: radial-gradient(
      circle at center,
      var(--hair) 0 1px,
      transparent 1.2px
    );
    background-size: 11px 11px;
  }
</style>

<script>
  /* Cipherbound's tile field: 12×8 cells, a scatter of blocked ones, drawn
     once on load. Generated rather than authored so the grid stays regular. */
  const NS = "http://www.w3.org/2000/svg";
  const tiles = document.querySelector(".tiles");
  const blocked = document.querySelector(".blocked");

  if (tiles && blocked) {
    const S = 24;
    const OX = 14;
    const OY = 26;
    for (let y = 0; y < 8; y++) {
      for (let x = 0; x < 12; x++) {
        const r = document.createElementNS(NS, "rect");
        r.setAttribute("x", String(OX + x * S));
        r.setAttribute("y", String(OY + y * S));
        r.setAttribute("width", String(S));
        r.setAttribute("height", String(S));
        tiles.appendChild(r);
      }
    }
    const walls: [number, number][] = [
      [1, 1],
      [2, 1],
      [5, 0],
      [8, 2],
      [9, 2],
      [3, 3],
      [6, 4],
      [10, 5],
      [2, 6],
      [7, 6],
      [11, 3],
    ];
    for (const [x, y] of walls) {
      const r = document.createElementNS(NS, "rect");
      r.setAttribute("x", String(OX + x * S + 5));
      r.setAttribute("y", String(OY + y * S + 5));
      r.setAttribute("width", String(S - 10));
      r.setAttribute("height", String(S - 10));
      blocked.appendChild(r);
    }
  }
</script>
