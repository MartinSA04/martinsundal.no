---
/**
 * One drawing per project, describing the thing rather than decorating it.
 *
 * These are bespoke, not parametric: a converging bundle only means something
 * for the API, a stipple terminator only for the renderer. Each is authored
 * once and read at build time, so nothing is generated in the browser.
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{
  slug === "study-companion" && (
    <svg
      class="ins"
      viewBox="0 0 300 260"
      style="width:100%;max-width:300px;height:auto"
      aria-hidden="true"
    >
      {/* The course, authored as data rows */}
      <g class="h">
        <path d="M14 40h96M14 58h74M14 76h96M14 94h58M14 112h88M14 130h70M14 148h96M14 166h50" />
      </g>
      <path class="d" d="M8 30h112v148H8z" />
      <text x="8" y="22">
        Authored as data
      </text>
      {/* One source, compiled */}
      <path class="h" d="M126 104h26" />
      <circle class="f" cx="156" cy="104" r="3" />
      <path class="h" d="M160 104h14" />
      {/* Out to a stack of registered plates */}
      <g class="h">
        <path d="M186 58l72-18 34 18-72 18z" />
        <path d="M186 96l72-18 34 18-72 18z" />
        <path d="M186 134l72-18 34 18-72 18z" />
        <path d="M186 172l72-18 34 18-72 18z" />
      </g>
      <g class="d">
        <path d="M186 58v114M292 76v114M258 40v114" />
      </g>
      <circle class="node" cx="222" cy="49" r="4" />
      <circle class="node" cx="222" cy="87" r="4" />
      <circle class="node" cx="222" cy="125" r="4" />
      <circle class="node" cx="222" cy="163" r="4" />
      <text x="186" y="212">
        04 plates
      </text>
      <text x="0" y="252">
        Astro
      </text>
      <text x="300" y="252" text-anchor="end">
        Content model
      </text>
    </svg>
  )
}

