{
  slug === "cipherbound" && (
    <svg
      class="ins"
      viewBox="0 0 300 250"
      style="width:100%;max-width:var(--fig-cap, 300px);height:auto"
      aria-hidden="true"
    >
      <defs>
        {/* The shading breaks where a feature interrupts it, and is cut at the
          band so the half that belongs to the shell can lift with it. */}
        <mask id="cb-shade-top">
          <rect x="0" y="0" width="300" height="250" fill="#000" />
          <circle cx={cb.cx} cy={cb.cy} r={cb.R} fill="#fff" />
          <rect
            x="0"
            y={r1(cb.cy - cbB)}
            width="300"
            height="250"
            fill="#000"
          />
          <circle cx={cb.cx} cy={cb.cy} r={r1(cb.R * 0.36)} fill="#000" />
        </mask>
        <mask id="cb-shade-bot">
          <rect x="0" y="0" width="300" height="250" fill="#000" />
          <circle cx={cb.cx} cy={cb.cy} r={cb.R} fill="#fff" />
          <rect x="0" y="0" width="300" height={r1(cb.cy + cbB)} fill="#000" />
          <circle cx={cb.cx} cy={cb.cy} r={r1(cb.R * 0.36)} fill="#000" />
        </mask>
      </defs>

      {/* Object lines carry the drawing; shading and annotation stay under it,
        which is the same hierarchy a real sheet uses. */}
      <g mask="url(#cb-shade-bot)">
        <path class="h" d={cbShade} />
      </g>
      <path class="i" d={cbLower} />
      {/* The cavity is hidden behind the shell, so it goes in broken line. */}
      <path class="d" d={cbCavityLower} />

      {/* Everything that swings clear of the band when the device opens. Its
        mask travels with it, so the shading stays stuck to the shell. */}
      <g class="cb-lid">
        <g mask="url(#cb-shade-top)">
          <path class="h" d={cbShade} />
        </g>
        <path class="i" d={cbUpper} />
        <path class="d" d={cbCavityUpper} />
      </g>

      {/* The release stands proud of the band, so the band breaks at it. */}
      <path class="i" d={cbBand} />
      <circle class="i" cx={cb.cx} cy={cb.cy} r={r1(cb.R * 0.33)} />
      <circle class="i" cx={cb.cx} cy={cb.cy} r={r1(cb.R * 0.17)} />
      <circle
        class="i"
        cx={r1(cb.cx - cb.R - cb.R * 0.07)}
        cy={cb.cy}
        r={r1(cb.R * 0.07)}
      />

      <path class="h" d={cbLeads} />
      <path class="fh" d={cbHeads} />
      {cbRefs.map((r) => (
        <text class="num" x={r.x} y={r.y} text-anchor="middle">
          {r.n}
        </text>
      ))}

      <text x="0" y="242">
        Fig. 1 · capture device
      </text>
      <text x="300" y="242" text-anchor="end">
        C++
      </text>
    </svg>
  )
}

