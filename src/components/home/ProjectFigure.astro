      <path class="d" d="M230 0v400M42 200h376" />
      <circle class="f" cx="230" cy="200" r="2.4" />
      <text x="0" y="38">
        Undeflected
      </text>
      <text x="0" y="200" dy="-6">
        Deflected
      </text>
      <text x="248" y="196">
        Event horizon
      </text>
      <text x="248" y="184">
