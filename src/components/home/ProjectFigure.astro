      <g class="d">
        <path d="M0 46h460" />
        <path d="M0 92h460" />
        <path d="M0 308h460" />
        <path d="M0 354h460" />
      </g>
      <g class="h">
        <path d="M0 46C150 46 300 78 460 132" />
        <path d="M0 92C160 92 300 152 460 246" />
        <path d="M0 354C150 354 300 322 460 268" />
        <path d="M0 308C160 308 300 248 460 154" />
