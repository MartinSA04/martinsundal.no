{
  slug === "cipherbound" && (
    <svg
      class="ins"
      viewBox="0 0 300 250"
      style="width:100%;max-width:300px;height:auto"
      aria-hidden="true"
    >
      <defs>
        {/* The shading breaks where a feature interrupts it. */}
        <mask id="cb-shade">
          <rect x="0" y="0" width="300" height="250" fill="#000" />
          <circle cx={cb.cx} cy={cb.cy} r={cb.R} fill="#fff" />
          <rect
            x="0"
            y={r1(cb.cy - cbB)}
            width="300"
            height={r1(cbB * 2)}
            fill="#000"
          />
          <circle cx={cb.cx} cy={cb.cy} r={r1(cb.R * 0.36)} fill="#000" />
        </mask>
      </defs>

      <g mask="url(#cb-shade)">
        <path class="h" d={cbShade} />
      </g>

      {/* Object lines carry the drawing; shading and annotation stay under it,
        which is the same hierarchy a real sheet uses. */}
      <circle class="i" cx={cb.cx} cy={cb.cy} r={cb.R} />
      {/* The release stands proud of the band, so the band breaks at it. */}
      <path class="i" d={cbBand} />
      <circle class="i" cx={cb.cx} cy={cb.cy} r={r1(cb.R * 0.33)} />
      <circle class="i" cx={cb.cx} cy={cb.cy} r={r1(cb.R * 0.17)} />
      <circle
        class="i"
        cx={r1(cb.cx - cb.R - cb.R * 0.07)}
        cy={cb.cy}
        r={r1(cb.R * 0.07)}
      />
      {/* The cavity is hidden behind the shell, so it goes in broken line. */}
      <path
        class="d"
        d={`M${cb.cx} ${r1(cb.cy - cbRC)}A${r1(cbRC)} ${r1(cbRC)} 0 0 0 ${cb.cx} ${r1(cb.cy + cbRC)}`}
      />

      <path class="h" d={cbLeads} />
      <path class="fh" d={cbHeads} />
      {cbRefs.map((r) => (
        <text class="num" x={r.x} y={r.y} text-anchor="middle">
          {r.n}
        </text>
      ))}

      <text x="0" y="242">
        Fig. 1 · capture device
      </text>
      <text x="300" y="242" text-anchor="end">
        C++
      </text>
    </svg>
  )
}

