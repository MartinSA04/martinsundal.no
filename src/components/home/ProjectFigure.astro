    <svg
      class="ins"
      viewBox={`0 0 ${GOL.w * GOL.pitch} ${golBoardH + 26}`}
      style="width:100%;max-width:var(--fig-cap, 300px);height:auto"
      aria-hidden="true"
      data-synth
      data-w={GOL.w}
      data-pitch={GOL.pitch}
      data-cell={GOL.cell}
      data-frames={golFrames.map((f) => f.join(",")).join(";")}
    >
      <g class="mat">
        {golDots.map((d) => (
          <circle cx={d.cx} cy={d.cy} r="1.1" />
        ))}
      </g>
      <path class="d" d={golLeads} />
      {/* Generation 0 is server-rendered, so the plate is a correct still
        with the script missing or blocked. */}
      <path class="f" data-synth-cells d={golPath(golFrames[0]!)} />
      <text x="2" y={golBoardH + 20} data-synth-gen>
        Gen 00
      </text>
      <text x={GOL.w * GOL.pitch - 2} y={golBoardH + 20} text-anchor="end">
        2 gliders · 1 block
      </text>
    </svg>
  )
}

