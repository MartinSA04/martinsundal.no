        <circle class="h" cx="300" cy="155" r="8" />
        <circle class="f" cx="300" cy="155" r="2.6" />
        <circle class="f" cx="442" cy="96" r="3" />
        <circle class="f" cx="442" cy="155" r="3" />
        <circle class="f" cx="442" cy="214" r="3" />
        <text x="0" y="12">
