          <path d="M28 71C160 71 212 155 300 155" />
          <path d="M28 108C160 108 214 155 300 155" />
          <path d="M28 145C160 145 216 155 300 155" />
          <path d="M28 182C160 182 216 155 300 155" />
          <path d="M28 219C160 219 214 155 300 155" />
          <path d="M28 256C160 256 212 155 300 155" />
          <path d="M28 293C160 293 210 155 300 155" />
          <path d="M300 155C356 155 380 96 442 96" />
          <path d="M300 155h142" />
          <path d="M300 155C356 155 380 214 442 214" />
        </g>
        <g>
          <circle class="node" cx="28" cy="34" r="3.4" />
          <circle class="node" cx="28" cy="71" r="3.4" />
          <circle class="node" cx="28" cy="108" r="3.4" />
          <circle class="node" cx="28" cy="145" r="3.4" />
          <circle class="node" cx="28" cy="182" r="3.4" />
          <circle class="node" cx="28" cy="219" r="3.4" />
          <circle class="node" cx="28" cy="256" r="3.4" />
