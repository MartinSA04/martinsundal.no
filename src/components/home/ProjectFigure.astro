      {cbRefs.map((r) => (
        <text class="num" x={r.x} y={r.y} text-anchor="middle">
          {r.n}
        </text>
      ))}

      <text x="0" y="242">
        Fig. 1 · capture device
      </text>
      <text x="300" y="242" text-anchor="end">
        C++
