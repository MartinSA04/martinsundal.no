---
import type { CollectionEntry } from "astro:content";
import Mark from "../micro/Mark.astro";
import Tag from "../micro/Tag.astro";
import Barcode from "../micro/Barcode.astro";
import Icon from "../micro/Icon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section id="projects" class="projects">
  <div class="wrap">
    <Mark n={3} label="Index" note={`${projects.length} entries`} />

    <ol class="rows">
      {
        projects.map((entry) => {
          const p = entry.data;
          const style = [
            `--w-sub:${p.world.sub}`,
            `--w-ink:${p.world.ink}`,
            `--w-hair:${p.world.hair}`,
            `--w-sig:${p.world.sig}`,
          ].join(";");
          return (
            <li class="project-card card" style={style}>
              <a class="row" href={`/projects/${entry.id}/`}>
                {/* The instrument gutter. Read down the page these stack into
                    one continuous column of marks, which is what makes five
                    rows a specimen sheet rather than five isolated blocks.

                    `.n` keeps its own box and its own cap correction — the
                    wrapper starts on the same line, so the numeral's box top
                    is unchanged and e2e/home.spec.ts still holds. */}
                <span class="gutter" aria-hidden="true">
                  <span class="n">{String(p.index).padStart(2, "0")}</span>
                  <Barcode seed={entry.id} bars={10} />
                  <span class="dots">
                    {Array.from({ length: 5 }, (_, i) => (
                      <i data-on={i < p.index ? "" : undefined} />
                    ))}
                  </span>
                </span>

                <span class="body">
                  <span class="name">{p.name}</span>
                  <span class="tagline">{p.tagline}</span>
                  <span class="tags">
                    {p.tags.slice(0, 4).map((t) => (
                      <Tag>{t}</Tag>
                    ))}
                  </span>
                </span>

                {/* Every row gets a plate, drawn in that world's own four
                    tokens, so five rows read as five identities rather than
                    five strips. Two projects have a real image and it fills
                    the plate; the rest get the world's texture. */}
                <span class="plate" data-motif={entry.id} aria-hidden="true">
                  {p.image ? (
                    <img
                      src={p.image.src}
                      alt=""
                      width={p.image.width}
                      height={p.image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : null}
                </span>

                {/* Wrapped, not classed. A class handed to a component lands
                    on that component's own root, which carries its own scope
                    attribute — so `.go` scoped to this file never matched it.
                    The arrow was consequently never hidden on a phone, never
                    took --muted, and never animated on hover. */}
                <span class="go" aria-hidden="true">
                  <Icon name="arrow-right" size={20} />
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .projects {
    padding-block: var(--space-4);
  }

  .rows {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    border-top: var(--rule) solid var(--hair);
  }

  .project-card {
    border-bottom: var(--rule) solid var(--hair);
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  /* The world's own substrate washes in on hover, so the row previews the page
     it leads to. Bled past the gutter so it reads as the world arriving. */
  .row::before {
    content: "";
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.5);
    background: var(--w-sub);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: -1;
  }

  .row:hover::before,
  .row:focus-visible::before {
    opacity: 1;
  }

  .row:hover,
  .row:focus-visible {
    color: var(--w-ink);
  }

  /* The gutter stacks the numeral, the slug's barcode and the index dots.
     align-self: start keeps its box top on the row's first line, which is
     exactly where the bare numeral used to start — so the cap correction
     below still measures against the same origin. */
  .gutter {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    align-self: start;
  }

  /* The index numeral replaces the coloured edge stripe this row used to
     carry. It stays on --muted until the world's substrate is behind it,
     because several worlds' signals are unreadable on bone. */
  .n {
    font-family: var(--font-mono);
    font-size: var(--step-3);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--muted);
    align-self: start;
    /* Cap tops, not box tops. Both boxes already start on the same line; the
       cap sits (ascent - cap-height) below each box top, which is a fixed
       fraction of that element's own font size — measured at 0.157 for
       Archivo at line-height 1.05 and 0.168 for Plex Mono at line-height 1.
       Cancelling the difference tracks both type steps, where the 0.35rem
       this replaces was tuned at one width and drifted 6px to 9.6px across
       the range. e2e/home.spec.ts asserts the result at four widths. */
    translate: 0 calc(var(--step-2) * 0.157 - var(--step-3) * 0.168);
    transition: color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .n,
  .row:focus-visible .n {
    color: var(--w-sig);
  }

  .body {
    display: grid;
    gap: 0.3rem;
  }

  .name {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .tagline {
    color: var(--muted);
    max-width: 52ch;
    font-size: var(--step-0);
  }

  .row:hover .tagline,
  .row:focus-visible .tagline {
    color: color-mix(in oklab, var(--w-ink) 70%, var(--w-sub));
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    margin-top: 0.3rem;
  }

  /* Index dots: filled up to this project's own number, so the column reads
     as a position indicator running down the sheet. */
  .dots {
    display: flex;
    gap: 3px;
  }

  .dots > i {
    inline-size: 4px;
    block-size: 4px;
    border-radius: 50%;
    border: var(--rule) solid var(--hair);
  }

  .dots > i[data-on] {
    background: var(--muted);
    border-color: var(--muted);
  }

  .row:hover .dots > i[data-on],
  .row:focus-visible .dots > i[data-on] {
    background: var(--w-sig);
    border-color: var(--w-sig);
  }

  /* --- the world plate --------------------------------------------------- */

  .plate {
    position: relative;
    display: block;
    width: clamp(7rem, 13vw, 12rem);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--w-sub);
    border: var(--rule) solid var(--hair);
    transition: border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .plate,
  .row:focus-visible .plate {
    border-color: var(--w-hair);
  }

  .plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    opacity: 0.8;
    transition:
      filter 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .plate img,
  .row:focus-visible .plate img {
    filter: none;
    opacity: 1;
  }

  /* Worlds without a screenshot get their own texture instead, drawn from the
     same four tokens the page itself uses. */
  .plate[data-motif="study-companion"]::before {
    content: "";
    position: absolute;
    inset: 12% 14%;
    background:
      repeating-linear-gradient(
        to bottom,
        var(--w-hair) 0 1px,
        transparent 1px 9px
      ),
      linear-gradient(to right, var(--w-sig) 0 2px, transparent 2px);
  }

  .plate[data-motif="ntnu-api"]::before {
    content: "";
    position: absolute;
    inset: 16% 12%;
    background-image:
      linear-gradient(var(--w-sig), var(--w-sig)),
      linear-gradient(var(--w-hair), var(--w-hair)),
      linear-gradient(var(--w-hair), var(--w-hair)),
      linear-gradient(var(--w-sig), var(--w-sig)),
      linear-gradient(var(--w-hair), var(--w-hair));
    background-repeat: no-repeat;
    background-size:
      38% 3px,
      72% 3px,
      54% 3px,
      26% 3px,
      64% 3px;
    background-position:
      0 0,
      0 22%,
      0 44%,
      0 66%,
      0 88%;
  }

  .plate[data-motif="game-of-life"]::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        to right,
        var(--w-hair) 0 1px,
        transparent 1px 11px
      ),
      repeating-linear-gradient(
        to bottom,
        var(--w-hair) 0 1px,
        transparent 1px 11px
      );
  }

  /* A glider, on the grid it lives on. */
  .plate[data-motif="game-of-life"]::after {
    content: "";
    position: absolute;
    left: 33px;
    top: 22px;
    width: 10px;
    height: 10px;
    background: var(--w-sig);
    box-shadow:
      11px 11px 0 var(--w-sig),
      -11px 22px 0 var(--w-sig),
      0 22px 0 var(--w-sig),
      11px 22px 0 var(--w-sig);
  }

  .go {
    display: block;
    line-height: 0;
    color: var(--muted);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .go,
  .row:focus-visible .go {
    transform: translateX(5px);
    color: var(--w-sig);
  }

  @media (max-width: 52rem) {
    .row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
    }
    .go {
      display: none;
    }
    /* Both are --step-2 from here down, so the cap correction collapses to
       the difference between the two fonts' own constants. */
    .n {
      font-size: var(--step-2);
      translate: 0 calc(var(--step-2) * -0.011);
    }
  }

  @media (max-width: 34rem) {
    .row {
      grid-template-columns: auto minmax(0, 1fr);
    }
    /* The plate keeps its box, but stops competing with the name on a narrow
       screen. */
    .plate {
      grid-column: 2;
      width: 100%;
      max-width: 11rem;
      margin-top: var(--space-1);
    }
  }
</style>
