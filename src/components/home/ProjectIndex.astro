---
/**
 * Plate 03 — Index.
 *
 * Each row is a coupling rather than a card: a figure column that sets the
 * row's height, and a name whose rule and readout are cut to its own width by
 * a max-content wrapper. No box is drawn round anything.
 */
import type { CollectionEntry } from "astro:content";
import Mark from "../micro/Mark.astro";
import Tag from "../micro/Tag.astro";
import Figure from "../micro/Figure.astro";
import Icon from "../micro/Icon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

/* One figure per project, chosen to describe the thing rather than decorate
   it: layered rings for a course authored as data, a hub fanning out to
   clients for the API, a tiled quadrant for the game, the accretion mark for
   the renderer, and a live glider on its own grid for the automaton. */
const FIGURES = {
  "study-companion": "concentric",
  "ntnu-api": "starburst",
  cipherbound: "quadrant",
  "black-hole": "eclipse",
  "game-of-life": "target",
} as const;
---

<section id="projects" class="projects">
  <div class="wrap">
    <Mark
      n={3}
      label="Index"
      figure="lozenges"
      note={`${projects.length} entries`}
    />

    <ol class="rows">
      {
        projects.map((entry) => {
          const p = entry.data;
          const style = [
            `--w-sub:${p.world.sub}`,
            `--w-ink:${p.world.ink}`,
            `--w-hair:${p.world.hair}`,
            `--w-sig:${p.world.sig}`,
          ].join(";");
          return (
            <li class="project-card card" style={style}>
              <a class="row" href={`/projects/${entry.id}/`}>
                <span class="body">
                  {/* The mark is the figure and its number as one object, and
                      it floats in the copy rather than standing in a column
                      beside it. The name and the sentence are displaced by the
                      circle; remove it and the whole block re-rags. */}
                  <span class="motif" aria-hidden="true">
                    <Figure
                      name={FIGURES[entry.id as keyof typeof FIGURES]}
                      size={132}
                    />
                    <span class="n">{String(p.index).padStart(2, "0")}</span>
                  </span>
                  {/* The name, its rule and its stack are one object. The
                      wrapper is max-content, so the rule can only ever be the
                      name's width. */}
                  <span class="nameplate">
                    <span class="name">{p.name}</span>
                    <span class="name-rule" aria-hidden="true" />
                  </span>
                  <span class="tagline">{p.tagline}</span>
                  <span class="name-tags">
                    {p.tags.slice(0, 4).map((t) => (
                      <Tag>{t}</Tag>
                    ))}
                  </span>
                </span>

                {/* Every row gets a plate in that world's own four tokens, so
                    five rows read as five identities. Two projects have a real
                    image; the rest get the world's texture. */}
                <span class="shot" aria-hidden="true">
                  <span class="plate" data-motif={entry.id}>
                    {p.image ? (
                      <img
                        src={p.image.src}
                        alt=""
                        width={p.image.width}
                        height={p.image.height}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : null}
                  </span>
                </span>

                {/* Wrapped, not classed: a class handed to a component lands on
                    that component's own root, which carries its own scope
                    attribute and never matches this file's styles. */}
                <span class="go" aria-hidden="true">
                  <Icon name="arrow-right" size={20} />
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .projects {
    padding-block: var(--space-4);
  }

  .rows {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  /* A hairline between rows, not a box round each. */
  .project-card + .project-card .row::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    block-size: var(--rule);
    background: var(--hair);
  }

  /* The world's own substrate washes in on hover, so the row previews the page
     it leads to. Bled past the gutter so it reads as the world arriving. */
  .row::before {
    content: "";
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.5);
    background: var(--w-sub);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: -1;
  }

  .row:hover::before,
  .row:focus-visible::before {
    opacity: 1;
  }

  .row:hover,
  .row:focus-visible {
    color: var(--w-ink);
  }

  /* A structural column: the figure is 92px and the column is sized to it, so
     the five marks form a load-bearing band down the left of the sheet. */
  /* Straddling the ring, in a counter punched from the substrate. Every
     figure in the set has a busy centre — a filled disc, a hub, a quadrant —
     so a numeral laid over the middle is unreadable. Setting it on the
     shoulder gives it a hole of its own and keeps mark and number one
     object. */
  .n {
    position: absolute;
    left: 0;
    top: 4%;
    inline-size: 2.1em;
    block-size: 2.1em;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sub);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--ink);
    transition:
      color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .n,
  .row:focus-visible .n {
    background: var(--w-sub);
    color: var(--w-sig);
  }

  /* Every figure in this set is drawn inside its own circle, so one circular
     wrap fits all five and the copy hugs the silhouette rather than a box. */
  .motif {
    position: relative;
    float: left;
    display: block;
    inline-size: 132px;
    block-size: 132px;
    shape-outside: circle(50%);
    shape-margin: 14px;
    margin-inline-end: 4px;
    color: var(--muted);
    transition: color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .motif,
  .row:focus-visible .motif {
    color: var(--w-sig);
  }

  /* Top-aligned: the 92px figure makes the gutter the tallest thing in the
     row, so a centred body would sink and the numeral would stop sitting
     beside the name it numbers. */
  /* Flow, not grid: a float only displaces inline content in normal flow, so
     a grid here would leave the figure sitting in a cell of its own — which is
     exactly the row-marker layout this replaces. */
  .body {
    align-self: start;
    min-inline-size: 0;
  }

  .body > * + * {
    margin-block-start: 0.4rem;
  }

  /* A grid is a block formatting context, so it will not overlap the float —
     but only if it is allowed to shrink. Forced to 100% it sits on top of the
     mark and the name renders over the circle. fit-content both cuts the rule
     to the name and keeps the block clear of the figure at every width. */
  .nameplate {
    display: grid;
    gap: 0.4rem;
    inline-size: fit-content;
    max-inline-size: 100%;
  }

  .name {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .name-rule {
    block-size: var(--rule);
    background: var(--hair);
  }

  .row:hover .name-rule,
  .row:focus-visible .name-rule {
    background: var(--w-hair);
  }

  .name-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.9rem;
    padding-top: 0.2rem;
  }

  .tagline {
    display: block;
    color: var(--muted);
    font-size: var(--step-0);
  }

  .row:hover .tagline,
  .row:focus-visible .tagline {
    color: color-mix(in oklab, var(--w-ink) 70%, var(--w-sub));
  }

  /* --- the world plate --------------------------------------------------- */

  .shot {
    position: relative;
    display: block;
    flex: none;
  }

  /* Corner registration lives on this wrapper, because .plate's own ::before
     is the world motif and its overflow:hidden is what keeps the glider on
     its grid. */
  .shot::before,
  .shot::after {
    content: "";
    position: absolute;
    inline-size: 10px;
    block-size: 10px;
    border: 0 solid var(--hair);
    transition: border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .shot::before {
    top: -4px;
    left: -4px;
    border-top-width: var(--rule);
    border-left-width: var(--rule);
  }

  .shot::after {
    bottom: -4px;
    right: -4px;
    border-bottom-width: var(--rule);
    border-right-width: var(--rule);
  }

  .row:hover .shot::before,
  .row:hover .shot::after,
  .row:focus-visible .shot::before,
  .row:focus-visible .shot::after {
    border-color: var(--w-sig);
  }

  .plate {
    position: relative;
    display: block;
    width: clamp(7rem, 13vw, 12rem);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--w-sub);
  }

  .plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    opacity: 0.8;
    transition:
      filter 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .plate img,
  .row:focus-visible .plate img {
    filter: none;
    opacity: 1;
  }

  /* Worlds without a screenshot get their own texture instead, drawn from the
     same four tokens the page itself uses. */
  .plate[data-motif="study-companion"]::before {
    content: "";
    position: absolute;
    inset: 12% 14%;
    background:
      repeating-linear-gradient(
        to bottom,
        var(--w-hair) 0 1px,
        transparent 1px 9px
      ),
      linear-gradient(to right, var(--w-sig) 0 2px, transparent 2px);
  }

  .plate[data-motif="ntnu-api"]::before {
    content: "";
    position: absolute;
    inset: 16% 12%;
    background-image:
      linear-gradient(var(--w-sig), var(--w-sig)),
      linear-gradient(var(--w-hair), var(--w-hair)),
      linear-gradient(var(--w-hair), var(--w-hair)),
      linear-gradient(var(--w-sig), var(--w-sig)),
      linear-gradient(var(--w-hair), var(--w-hair));
    background-repeat: no-repeat;
    background-size:
      38% 3px,
      72% 3px,
      54% 3px,
      26% 3px,
      64% 3px;
    background-position:
      0 0,
      0 22%,
      0 44%,
      0 66%,
      0 88%;
  }

  .plate[data-motif="game-of-life"]::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        to right,
        var(--w-hair) 0 1px,
        transparent 1px 11px
      ),
      repeating-linear-gradient(
        to bottom,
        var(--w-hair) 0 1px,
        transparent 1px 11px
      );
  }

  /* A glider, on the grid it lives on. */
  .plate[data-motif="game-of-life"]::after {
    content: "";
    position: absolute;
    left: 33px;
    top: 22px;
    width: 10px;
    height: 10px;
    background: var(--w-sig);
    box-shadow:
      11px 11px 0 var(--w-sig),
      -11px 22px 0 var(--w-sig),
      0 22px 0 var(--w-sig),
      11px 22px 0 var(--w-sig);
  }

  .go {
    display: block;
    line-height: 0;
    color: var(--muted);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .go,
  .row:focus-visible .go {
    transform: translateX(5px);
    color: var(--w-sig);
  }

  @media (max-width: 60rem) {
    /* The columns follow the new structure: copy, thumbnail, arrow. */
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
    }
    .go {
      display: none;
    }
  }

  @media (max-width: 46rem) {
    /* The mark keeps floating — it is the layout — but at a size that still
       leaves a readable measure beside it on a phone. */
    .motif {
      inline-size: 84px;
      block-size: 84px;
      shape-margin: 10px;
    }
    .n {
      font-size: var(--step--1);
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--space-3);
    }
    .shot {
      justify-self: start;
      inline-size: 100%;
      max-inline-size: 13rem;
      margin-top: var(--space-2);
    }
    .plate {
      width: 100%;
    }
  }
</style>
