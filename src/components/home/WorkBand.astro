---
/**
 * Plate 02 — Engagement.
 *
 * Every factual claim here traces to material Aker Solutions has already
 * published: their own Verdal production site page and the captions baked
 * into their own highlights video. No internal figures, no process detail,
 * no Aker mark. See the confidentiality constraint in the site-rewrite spec.
 */
import Plate from "../micro/Plate.astro";
import Mark from "../micro/Mark.astro";
import Node from "../micro/Node.astro";
import Fan from "../micro/Fan.astro";
import Tag from "../micro/Tag.astro";
import Readout from "../micro/Readout.astro";
import Rule from "../micro/Rule.astro";
import Icon from "../micro/Icon.astro";

/* The five stages Aker lists for the line, in order. Drawn as a node chain
   rather than named in a sentence, so the band carries the shape of the
   process instead of a description of it. */
const stages = ["Cutting", "Welding", "Surface", "Coating", "Completion"];
---

<section class="band card">
  <div class="wrap">
    <Mark n={2} label="Engagement" figure="halfdisc" note="Day job" />
    <Rule variant="hazard" />

    <div class="grid">
      <div class="text">
        <h2>Aker Solutions, Verdal</h2>
        <p>
          I work on the robotics and industrial software behind the Verdal
          Production Line, a robotised line that welds, blasts and paints steel
          structures at Aker Solutions.
        </p>

        {
          /* Published by Aker on their own Verdal page and in the captions of
            their own highlights video. Nothing here is internal. */
        }
        <Readout
          layout="stack"
          pairs={[
            {
              label: "Capacity",
              value: "Up to one closed cage floater / week",
            },
            { label: "Automates", value: "Welding · sandblasting · painting" },
            { label: "Scanning", value: "3D models of components pre-build" },
            { label: "Domain", value: "Robotics · robot control · data" },
          ]}
        />

        <a class="cta" href="/work/">
          <span>The work in detail</span>
          <Icon name="arrow-right" />
        </a>
      </div>

      {
        /* The still the /work video opens on. It is the only photograph on the
          home page, so it does the job the project thumbnails cannot: showing
          that the day job is a physical line, not a codebase. */
      }
      <div class="figure">
        <Plate variant="corners">
          <a class="poster" href="/work/" tabindex="-1" aria-hidden="true">
            <img
              src="/vpl/poster.avif"
              alt=""
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span class="poster-tag">
              <Tag>Verdal Production Line</Tag>
            </span>
          </a>
        </Plate>

        {
          /* The fan spreads from the poster down onto the stage chain, so the
            line reads as one process feeding five stations rather than as a
            caption sitting under a photograph. */
        }
        <div class="spray" aria-hidden="true">
          <Fan rays={17} spread={126} accentEvery={8} size={80} />
        </div>

        <ol class="flow">
          {
            stages.map((stage, i) => (
              <li>
                <Node
                  label={stage}
                  glyph={String(i + 1)}
                  active={i === 1}
                  size={16}
                />
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: var(--space-4);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-3);
  }

  h2 {
    font-size: var(--step-3);
    margin-bottom: var(--space-2);
  }

  .text p {
    max-width: 44ch;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }

  .poster {
    display: block;
    position: relative;
    /* The poster is the one warm, saturated thing in an otherwise hairline
       page. Held back until hover so it reads as a plate in a document. */
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .poster:hover {
    filter: none;
  }

  .poster img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .poster-tag {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.35rem 0.6rem;
    background: var(--sub);
    border-top: var(--rule) solid var(--hair);
    border-right: var(--rule) solid var(--hair);
    line-height: 1;
  }

  /* The stage chain reads left to right with a hairline running between the
     nodes, which is what makes it a flow rather than a list of words. */
  /* The spray is a graphic join, not a spacer: it overlaps the gap between
     the poster and the chain so the two read as connected. */
  .spray {
    display: flex;
    justify-content: center;
    margin-block: calc(var(--space-2) * -1) calc(var(--space-3) * -1);
    color: var(--hair);
  }

  .flow {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
  }

  .flow li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .flow li:not(:last-child)::after {
    content: "";
    inline-size: var(--space-3);
    block-size: var(--rule);
    background: var(--hair);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: var(--rule) solid var(--sig);
    padding-bottom: 0.2rem;
  }

  .cta:hover {
    color: var(--sig);
  }

  @media (max-width: 46rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
