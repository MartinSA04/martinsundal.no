---
/**
 * Plate 02 — Engagement.
 *
 * Every factual claim here traces to material Aker Solutions has already
 * published: their own Verdal production site page and the captions baked
 * into their own highlights video. No internal figures, no process detail,
 * no Aker mark. See the confidentiality constraint in the site-rewrite spec.
 */
import Plate from "../micro/Plate.astro";
import Mark from "../micro/Mark.astro";
import Node from "../micro/Node.astro";
import Fan from "../micro/Fan.astro";
import Tag from "../micro/Tag.astro";
import Readout from "../micro/Readout.astro";
import Rule from "../micro/Rule.astro";
import Marginalia from "../micro/Marginalia.astro";
import Figure from "../micro/Figure.astro";
import Icon from "../micro/Icon.astro";

/* The five stages Aker lists for the line, in order. Drawn as a node chain
   rather than named in a sentence, so the band carries the shape of the
   process instead of a description of it. */
const stages = ["Cutting", "Welding", "Surface", "Coating", "Completion"];
---

<section class="band card">
  <div class="wrap">
    <Mark n={2} label="Engagement" figure="halfdisc" note="Day job" />
    <Rule variant="hazard" />

    <div class="grid">
      {
        /* The arc is the band's left boundary. Everything in the text column
          starts where the half-disc ends, and the rotated label runs along
          its flat edge — the composition the reference sheets build around
          their large semicircles, rather than a shape parked in a margin. */
      }
      <div class="arc" aria-hidden="true">
        <Figure name="halfdisc" size={176} outline />
        <Marginalia text="Verdal · robotised line" side="left" />
      </div>

      <div class="text">
        <h2>Aker Solutions, Verdal</h2>
        <p>
          I work on the robotics and industrial software behind the Verdal
          Production Line, a robotised line that welds, blasts and paints steel
          structures at Aker Solutions.
        </p>

        {
          /* Published by Aker on their own Verdal page and in the captions of
            their own highlights video. Nothing here is internal. */
        }
        <Readout
          layout="stack"
          pairs={[
            {
              label: "Capacity",
              value: "Up to one closed cage floater / week",
            },
            { label: "Automates", value: "Welding · sandblasting · painting" },
            { label: "Scanning", value: "3D models of components pre-build" },
            { label: "Domain", value: "Robotics · robot control · data" },
          ]}
        />

        <a class="cta" href="/work/">
          <span>The work in detail</span>
          <Icon name="arrow-right" />
        </a>
      </div>

      {
        /* The still the /work video opens on. It is the only photograph on the
          home page, so it does the job the project thumbnails cannot: showing
          that the day job is a physical line, not a codebase. */
      }
      <div class="figure">
        <Plate variant="corners">
          <a class="poster" href="/work/" tabindex="-1" aria-hidden="true">
            <img
              src="/vpl/poster.avif"
              alt=""
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span class="poster-tag">
              <Tag>Verdal Production Line</Tag>
            </span>
          </a>
        </Plate>

        {
          /* The same composition the reference sheets build around CONFIG: an
            axis rule with the fan's hub sitting on it, rays spreading down
            onto the stations below. The rule runs out both sides and closes
            on end caps, so the poster, the fan and the stage chain are one
            interlocked unit rather than three stacked blocks. */
        }
        <div class="spray" aria-hidden="true">
          <span class="spray-axis">
            <span class="spray-cap"></span>
            <span class="spray-rule"></span>
            <span class="spray-cap"></span>
          </span>
          <Fan rays={19} spread={132} accentEvery={9} size={132} />
        </div>

        <ol class="flow">
          {
            stages.map((stage, i) => (
              <li>
                <Node
                  label={stage}
                  glyph={String(i + 1)}
                  active={i === 1}
                  size={16}
                />
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: var(--space-4);
  }

  .grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-3) var(--space-4);
    align-items: start;
    margin-top: var(--space-3);
  }

  /* Flat edge to the outside, arc facing the copy: the shape opens the band
     and the label reads up its straight side. */
  .arc {
    display: flex;
    align-items: stretch;
    gap: var(--space-1);
    color: var(--hair);
    rotate: 180deg;
  }

  h2 {
    font-size: var(--step-3);
    margin-bottom: var(--space-2);
  }

  .text p {
    max-width: 44ch;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }

  .poster {
    display: block;
    position: relative;
    /* The poster is the one warm, saturated thing in an otherwise hairline
       page. Held back until hover so it reads as a plate in a document. */
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .poster:hover {
    filter: none;
  }

  .poster img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .poster-tag {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.35rem 0.6rem;
    background: var(--sub);
    border-top: var(--rule) solid var(--hair);
    border-right: var(--rule) solid var(--hair);
    line-height: 1;
  }

  /* The stage chain reads left to right with a hairline running between the
     nodes, which is what makes it a flow rather than a list of words. */
  /* The spray is a graphic join, not a spacer: it overlaps the gap between
     the poster and the chain so the two read as connected. */
  /* The fan hangs from the axis rather than sitting under it: the Fan's hub
     is at the top of its own box, so aligning the box top to the rule puts
     the hub exactly on the line. */
  .spray {
    position: relative;
    display: flex;
    justify-content: center;
    margin-block: var(--space-3) 0;
    block-size: 132px;
    color: var(--hair);
  }

  .spray-axis {
    position: absolute;
    inset-inline: 0;
    top: 0;
    display: flex;
    align-items: center;
  }

  .spray-rule {
    flex: 1;
    block-size: var(--rule);
    background: var(--hair);
  }

  .spray-cap {
    inline-size: 5px;
    block-size: 5px;
    border: var(--rule) solid var(--hair);
    border-radius: 50%;
    flex: none;
  }

  /* The rays fade as they reach the stations, so the fan reads as spreading
     onto the chain instead of stopping at an arbitrary line. */
  .spray :global(.micro-fan) {
    position: relative;
    mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
  }

  .flow {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
  }

  .flow li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .flow li:not(:last-child)::after {
    content: "";
    inline-size: var(--space-3);
    block-size: var(--rule);
    background: var(--hair);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: var(--rule) solid var(--sig);
    padding-bottom: 0.2rem;
  }

  .cta:hover {
    color: var(--sig);
  }

  @media (max-width: 76rem) {
    /* The arc is a column, and below this width there is not one to give it
       without squeezing the copy to nothing. */
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
    .arc {
      display: none;
    }
  }

  @media (max-width: 46rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
