---
/**
 * Plate 02 — Engagement.
 *
 * Every factual claim here traces to material Aker Solutions has already
 * published: their own Verdal production site page and the captions baked
 * into their own highlights video. No internal figures, no process detail,
 * no Aker mark. See the confidentiality constraint in the site-rewrite spec.
 */
import Mark from "../micro/Mark.astro";
import Chain from "../micro/Chain.astro";
import Pill from "../micro/Pill.astro";
import Tag from "../micro/Tag.astro";
import Readout from "../micro/Readout.astro";
import Icon from "../micro/Icon.astro";

/* The five stages Aker lists for the line, in order. */
const stages = ["Cutting", "Welding", "Surface", "Coating", "Completion"];
---

<section class="band card">
  <div class="wrap">
    <Mark n={2} label="Engagement" figure="halfdisc" note="Day job" />

    <div class="grid">
      <div class="text">
        {
          /* The heading and its rule are one object — the wrapper is sized by
            the heading, so the rule beneath is exactly its width. */
        }
        <div class="headline">
          <h2>Aker Solutions, Verdal</h2>
          <span class="headline-rule" aria-hidden="true"></span>
          <span class="headline-foot micro-label" aria-hidden="true">
            Robotics · welding automation
          </span>
        </div>

        {
          /* The pills sit in the lowercase band on the sentence's own
            baseline, so the statuses are set into the copy rather than
            captioned beside it. */
        }
        <p class="body">
          I work on the robotics and industrial software behind the Verdal
          Production Line — a <Pill>robotised</Pill> line that welds, blasts and paints
          steel structures, and scans components into <Pill signal
            >3D models</Pill
          > before they are built.
        </p>

        <Readout
          layout="stack"
          pairs={[
            {
              label: "Capacity",
              value: "Up to one closed cage floater / week",
            },
            { label: "Automates", value: "Welding · sandblasting · painting" },
            { label: "Covers", value: "Cut · weld · treat · coat · complete" },
          ]}
        />

        <a class="cta" href="/work/">
          <span>The work in detail</span>
          <Icon name="arrow-right" />
        </a>
      </div>

      <div class="figure">
        {
          /* The only photograph on the home page: it does the job the project
            thumbnails cannot, showing that the day job is a physical line and
            not a codebase. Registered at two corners, not framed. */
        }
        <div class="shot">
          <a class="poster" href="/work/" tabindex="-1" aria-hidden="true">
            <img
              src="/vpl/poster.avif"
              alt=""
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </a>
          <span class="poster-tag"><Tag>Verdal Production Line</Tag></span>
        </div>

        {
          /* The stations are not labels on a rule; the rule is broken to make
            room for them, so the copy sets the rhythm. */
        }
        <Chain items={stages} active={1} />
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: var(--space-4);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .headline {
    display: grid;
    inline-size: max-content;
    max-inline-size: 100%;
    gap: 0.45rem;
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--step-3);
    margin: 0;
    line-height: 1;
  }

  .headline-rule {
    block-size: var(--rule);
    background: var(--ink);
  }

  .headline-foot {
    font-size: var(--step--2);
  }

  .body {
    max-width: 46ch;
    margin: 0 0 var(--space-3);
    font-size: var(--step-0);
    line-height: 1.55;
  }

  .shot {
    position: relative;
    display: block;
    margin-bottom: var(--space-4);
  }

  /* Registration, not a frame. */
  .shot::before,
  .shot::after {
    content: "";
    position: absolute;
    inline-size: 14px;
    block-size: 14px;
    border: 0 solid var(--hair);
  }

  .shot::before {
    top: -5px;
    left: -5px;
    border-top-width: var(--rule);
    border-left-width: var(--rule);
  }

  .shot::after {
    bottom: -5px;
    right: -5px;
    border-bottom-width: var(--rule);
    border-right-width: var(--rule);
  }

  .poster {
    display: block;
    /* The one warm, saturated thing on an otherwise hairline page. Held back
       until hover so it reads as a plate in a document. */
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .poster:hover {
    filter: none;
  }

  .poster img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .poster-tag {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.4rem 0.6rem;
    background: var(--sub);
    line-height: 1;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: var(--rule) solid var(--sig);
    padding-bottom: 0.2rem;
  }

  .cta:hover {
    color: var(--sig);
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .headline {
      inline-size: 100%;
    }
  }
</style>
