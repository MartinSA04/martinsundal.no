---
import Rule from "../micro/Rule.astro";
import SpecBlock from "../micro/SpecBlock.astro";
---

<section class="band card">
  <div class="wrap">
    <Rule label="Idx_01 / Day job" variant="hazard" />

    <div class="grid">
      <div class="text">
        <h2>Aker Solutions, Verdal</h2>
        <p>
          I work on the robotics and industrial software behind the Verdal
          Production Line, a robotised line that welds, blasts and paints steel
          structures at Aker Solutions.
        </p>
        <a class="cta" href="/work/">
          <span>The work in detail</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <SpecBlock
        rows={[
          { label: "Domain", value: "Robotics · welding automation" },
          { label: "Also", value: "Scanning · robot control · data" },
          { label: "Studying", value: "Applied physics & maths, NTNU" },
        ]}
      />
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: var(--space-5);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: start;
    margin-top: var(--space-3);
  }

  h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-2);
  }

  .text p {
    max-width: 44ch;
    color: var(--muted);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: var(--rule) solid var(--sig);
    padding-bottom: 0.2rem;
  }

  .cta:hover {
    color: var(--sig);
  }

  @media (max-width: 46rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
