---
/**
 * FIG. 03 — Day job: the prose and the card, sharing a band.
 *
 * The wording comes from my own LinkedIn summary, so everything said about
 * Aker here is already public under my name. No internal figures, no process
 * detail, no Aker mark. See the confidentiality constraint in the site-rewrite
 * spec, and docs/source-material.md.
 *
 * The welding planner is the team's, not mine: "one of the lead developers" is
 * the accurate claim and the sentence does not get to shed it.
 */
import Icon from "../micro/Icon.astro";
---

<div class="lower">
  <section class="zone" aria-labelledby="job-h">
    <h2 id="job-h" class="p-u p-u--lg p-u--ink zh">Fig. 03 — Day job</h2>
    <p class="lead">
      Our team builds the software for the Verdal Production Line, the world's
      first fully automated production line of its kind. I am one of the lead
      developers on the welding planner, where most of my work is the planning
      code itself, and I work on the production line GUI as well. A lot of the
      job is industrial robotics and robotic welding.
    </p>
    <p class="lead lead--n">
      Alongside that I have held introductory robotics courses for apprentices
      and built a few 3D printing projects. Right now I am pushing our machine
      learning work forward, starting with collecting and storing the data.
    </p>
  </section>

  <section class="zone card" aria-labelledby="emp-h">
    <div class="job-head">
      <h2 id="emp-h" class="p-u p-u--lg p-u--ink">Employer</h2>
      <span class="p-u p-tag">Since 2022</span>
    </div>
    <div class="p-rule" style="margin-top:9px"></div>
    <p class="job-name">Aker Solutions</p>
    <p class="p-u" style="margin-top:8px">Verdal · Norway</p>
    <a class="lnk" href="/work/">
      <span class="p-u p-u--lg p-u--ink">The work in detail</span>
      <Icon name="arrow-right" size={16} />
    </a>
    <div class="p-chain" style="margin-top:22px" aria-hidden="true">
      <span class="p-u p-pill">Robotics</span>
      <span class="p-u p-pill">Welding</span>
      <span class="p-u p-pill">Automation</span>
    </div>
  </section>
</div>

<style>
  .lower {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(34px, 5vw, 74px);
    margin-bottom: var(--loose);
    align-items: start;
  }

  .lead {
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.48;
    max-width: 36em;
    margin-top: 20px;
    letter-spacing: -0.006em;
  }

  /* The second paragraph is the aside, not the claim: it steps down a size and
     off the ink so the band still has one thing to read first. */
  .lead--n {
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.52;
    color: var(--muted);
    margin-top: 16px;
  }

  /* The card is the right-hand column's whole content, so it hangs off the top
     of the band rather than off a heading it no longer shares. */
  .card {
    padding-top: 4px;
  }

  .job-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .job-name {
    font-weight: 500;
    font-size: clamp(24px, 2.5vw, 34px);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-top: 14px;
  }

  .lnk {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    border-bottom: var(--rule) solid var(--hair);
    padding-bottom: 4px;
    margin-top: 18px;
    color: var(--muted);
  }

  .lnk:hover,
  .lnk:focus-visible {
    border-bottom-color: var(--ink);
    color: var(--ink);
  }

  @media (max-width: 67rem) {
    .lower {
      grid-template-columns: minmax(0, 1fr);
      gap: 52px;
    }
  }
</style>
