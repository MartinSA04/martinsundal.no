---
/**
 * FIG. 03 / 04 — Approach and day job, sharing a band.
 *
 * Everything Aker-related here traces to material they have already published.
 * No internal figures, no process detail, no Aker mark. See the confidentiality
 * constraint in the site-rewrite spec.
 */
import Icon from "../micro/Icon.astro";
---

<div class="lower">
  <section class="zone" aria-labelledby="app-h">
    <h2 id="app-h" class="p-u p-u--lg p-u--ink zh">Fig. 03 — Approach</h2>
    <p class="lead">
      I build software for the physical world, where geometry and motion drive
      the design, and for the systems that have to keep running around it. A
      game engine written from scratch teaches more about architecture than any
      tutorial, and a renderer that bends light teaches the geometry it is
      modelling — so the side projects are not a portfolio, they are how the
      reading gets done.
    </p>
  </section>

  <section class="zone" aria-labelledby="job-h">
    <div class="job-head">
      <h2 id="job-h" class="p-u p-u--lg p-u--ink zh">Fig. 04 — Day job</h2>
      <span class="p-u p-tag">Current</span>
    </div>
    <div class="p-rule" style="margin-top:9px"></div>
    <p class="job-name">Aker Solutions</p>
    <p class="p-u" style="margin-top:8px">Verdal · Norway</p>
    <a class="lnk" href="/work/">
      <span class="p-u p-u--lg p-u--ink">The work in detail</span>
      <Icon name="arrow-right" size={16} />
    </a>
    <div class="p-chain" style="margin-top:22px" aria-hidden="true">
      <span class="p-u p-pill">Engineering</span>
      <span class="p-u p-pill">Fabrication</span>
    </div>
  </section>
</div>

<style>
  .lower {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(34px, 5vw, 74px);
    margin-bottom: var(--loose);
    align-items: start;
  }

  .lead {
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.48;
    max-width: 36em;
    margin-top: 20px;
    letter-spacing: -0.006em;
  }

  .job-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .job-name {
    font-weight: 500;
    font-size: clamp(24px, 2.5vw, 34px);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-top: 14px;
  }

  .lnk {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    border-bottom: var(--rule) solid var(--hair);
    padding-bottom: 4px;
    margin-top: 18px;
    color: var(--muted);
  }

  .lnk:hover,
  .lnk:focus-visible {
    border-bottom-color: var(--ink);
    color: var(--ink);
  }

  @media (max-width: 67rem) {
    .lower {
      grid-template-columns: minmax(0, 1fr);
      gap: 52px;
    }
  }
</style>
