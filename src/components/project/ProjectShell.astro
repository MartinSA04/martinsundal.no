---
/**
 * The parts every project page shares: head, breadcrumbs, title block, spec
 * readout, links, and the prose body. Each world supplies its own CSS and
 * decides how all of it looks — this only fixes the document order, so the
 * pages stay comparable to a reader and to a crawler.
 *
 * Worlds are separate page files rather than one [slug] route so that each
 * page bundles only its own CSS and JS.
 */
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../seo/Breadcrumbs.astro";
import SpecBlock from "../micro/SpecBlock.astro";
import Rule from "../micro/Rule.astro";
import { projectGraph, projectTrail, SITE } from "../../lib/jsonld.ts";

interface Props {
  entry: CollectionEntry<"projects">;
  /** Rendered above the prose: the world's centerpiece. */
  centerpieceLabel?: string;
}

const { entry, centerpieceLabel } = Astro.props;
const p = entry.data;
const trail = projectTrail(p, entry.id);

const style = [
  `--sub:${p.world.sub}`,
  `--ink:${p.world.ink}`,
  `--hair:${p.world.hair}`,
  `--sig:${p.world.sig}`,
].join(";");
---

<Base
  title={`${p.name} | Martin Sundal Aspås`}
  description={p.tagline}
  canonicalPath={`/projects/${entry.id}/`}
  ogImage={`${SITE}/og/${entry.id}.png`}
  graph={projectGraph(p, entry.id)}
>
  <article data-world={entry.id} style={style}>
    <div class="wrap">
      <Breadcrumbs trail={trail} />

      <header class="head">
        <Rule
          label={`Idx_${String(p.index).padStart(2, "0")} / ${p.tags[0]}`}
        />
        <h1>{p.name}</h1>
        <p class="lede">{p.tagline}</p>
      </header>

      {
        Astro.slots.has("centerpiece") && (
          <section class="centerpiece" aria-label={centerpieceLabel ?? "Demo"}>
            <slot name="centerpiece" />
          </section>
        )
      }

      <div class="columns">
        <div class="prose">
          <slot />
        </div>

        <aside class="side">
          <SpecBlock rows={p.spec} />

          <ul class="links">
            {
              p.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    rel="noopener"
                    data-primary={l.primary ? "" : undefined}
                  >
                    <span>{l.label}</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </li>
              ))
            }
          </ul>

          {p.award ? <p class="award">{p.award}</p> : null}
        </aside>
      </div>
    </div>
  </article>
</Base>
