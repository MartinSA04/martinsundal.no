---
/**
 * Stations-and-flow diagram for the Verdal Production Line.
 *
 * Every station here comes from Aker Solutions' own public description of the
 * line (cutting, welding, surface treatment, coating, mechanical completion).
 * Nothing about internal layout, cycle times or equipment is represented,
 * because none of that is published.
 */
const STATIONS = [
  { id: "01", name: "Cut", note: "Plate and tubular" },
  { id: "02", name: "Scan", note: "3D models before production" },
  { id: "03", name: "Weld", note: "Robotic, tubular sections" },
  { id: "04", name: "Blast", note: "Surface treatment" },
  { id: "05", name: "Coat", note: "Protective coatings" },
  { id: "06", name: "MC", note: "Mechanical completion" },
];
---

<figure class="schematic">
  <div class="track" role="list">
    {
      STATIONS.map((s, i) => (
        <div class="station" role="listitem" style={`--i:${i}`}>
          <span class="node" aria-hidden="true" />
          <span class="id micro-index">{s.id}</span>
          <span class="name">{s.name}</span>
          <span class="note micro-label">{s.note}</span>
        </div>
      ))
    }
  </div>
  <figcaption class="micro-label">
    Process stages as published by Aker Solutions. Capacity up to one closed
    cage floater per week.
  </figcaption>
</figure>

<style>
  .schematic {
    margin: var(--space-4) 0 0;
  }

  .track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-2);
    position: relative;
    padding-top: var(--space-3);
  }

  /* The flow line the nodes sit on. */
  .track::before {
    content: "";
    position: absolute;
    top: calc(var(--space-3) + 5px);
    left: 0;
    right: 0;
    height: var(--rule);
    background: var(--hair);
  }

  .station {
    display: grid;
    gap: 0.3rem;
    position: relative;
  }

  .node {
    width: 11px;
    height: 11px;
    border: var(--rule) solid var(--sig);
    background: var(--sub);
    border-radius: 50%;
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .node::after {
      content: "";
      position: absolute;
      inset: 2px;
      border-radius: 50%;
      background: var(--sig);
      transform: scale(0);
      animation: fill 4.8s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.5s);
    }

    @keyframes fill {
      0%,
      8% {
        transform: scale(0);
      }
      16%,
      42% {
        transform: scale(1);
      }
      55%,
      100% {
        transform: scale(0);
      }
    }
  }

  .name {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.1;
  }

  .note {
    font-size: var(--step--2);
    line-height: 1.35;
  }

  figcaption {
    margin-top: var(--space-3);
    max-width: 52ch;
    line-height: 1.5;
  }

  @media (max-width: 52rem) {
    .track {
      grid-template-columns: repeat(3, 1fr);
      row-gap: var(--space-4);
    }
    .track::before {
      display: none;
    }
  }
</style>
