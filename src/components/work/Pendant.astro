---
/**
 * A robot teach pendant with something playing on its screen.
 *
 * Front elevation, drawn rather than photographed, for the same reason the
 * Cipherbound console is a front elevation: seen flat, the screen is an
 * axis-aligned rectangle, so the video sits in a box at measured coordinates
 * and is never skewed. A three-quarter view would need a homography.
 *
 * This is the OmniCore FlexPendant, drawn from two figures in ABB's operating
 * manual for OmniCore (3HAC065036): "Main parts" on page 20 and "Hard buttons"
 * on page 22. It is that pendant and not the older IRC5 one because of the
 * screen. The IRC5 shell spends nearly half its width on a keypad and a
 * joystick bowl standing side by side, so its panel never gets past about 45%
 * of the drawing however large the drawing is. The OmniCore is a widescreen
 * slab: joystick and hard buttons share one narrow spine down the right, and
 * the display takes 58%.
 *
 * The parts are where the manual puts them:
 *
 * - One moulded lug halfway down the left edge carries both the connector and
 *   the emergency stop. The cable leaves it sideways, straight out to the left
 *   through a tapered strain relief, and only hangs downward once it is clear of
 *   the casing. The stop sits on the face beside it, straddling the edge.
 * - Twelve hard buttons, two clusters of six in 3x2, above and below the
 *   joystick. Reading the manual's own numbering, the top cluster is mechanical
 *   unit / motion mode / motion mode over programmable key / messages /
 *   programmable key; the bottom is programmable / START / programmable over
 *   step BACKWARD / STOP / step FORWARD. Which is why four of the twelve carry
 *   nothing but a bar: those are the programmable ones, and on a pendant nobody
 *   has configured they are blank.
 * - Joystick between the clusters, in its bezel with a guard wing above and
 *   below and a serrated collar on the knob.
 * - Thumb button on the top shoulder, RFID mark on the left bezel.
 *
 * Nothing on the right-hand spine carries a literal coordinate. The twelve keys,
 * the joystick and its guards are all derived from SPINE_X, SPINE_TOP and
 * SPINE_BOT below, so the block is centred on itself by construction and shares
 * its top and bottom datum with the display well. Typing three clusters to three
 * eyeballed centres is what previously left the keys touching each other on one
 * side and crowding the moulded edge on the other.
 *
 * The lug's three parts — strain relief, cable and stop — are on LUG_Y for the
 * same reason. The lug is a symmetrical boss and anything mounted on it that
 * misses its axis reads as bolted on askew, which is the one error a flat
 * elevation cannot hide.
 *
 * It carries no maker's mark, which is the rule the site-rewrite spec applies
 * to Aker's: naming a tool in text is fine, reproducing its badge implies an
 * endorsement nobody gave. The glyphs are generic marks for the same reason —
 * ABB's pictograms are ABB's drawings, so the keys that carry a function get a
 * plain triangle or square and the rest get the manual's bars.
 *
 * The panel is drawn 16:9 rather than the real 16:10, which is the one place
 * the video wins over the manual: at this size a 16:10 box would letterbox the
 * clip for the sake of about four pixels of accuracy.
 *
 * Shell and lug are one path, not a rectangle with a bump laid behind it: two
 * shapes would put a seam down the middle of the lug where the shell's own edge
 * stroke crosses it.
 *
 * Shading is one rim rather than a gradient: this world draws hardware in flat
 * fills, and the shell only has to read as moulded, not as lit.
 *
 * The cable stub is stroked with vector-effect: non-scaling-stroke at the same
 * widths Cable.astro uses, so the drawn cable and the routed one are the same
 * gauge at every size the pendant is drawn at. Without it the stub would match
 * the run at exactly one viewport width. That fixed gauge is also why the strain
 * relief tapers: the run is a constant 11px however large the drawing gets, so a
 * boot of constant *drawing* units has to close the gap itself rather than meet
 * the cable at whatever mismatch the current viewport happens to produce.
 *
 * Stub before boot before shell, so each joint is covered by the part that
 * should own it: the cable starts well inside the boot and the boot runs on into
 * the lug, and neither one ends in mid-air against the other.
 *
 * The gland is a real element rather than a coordinate, because Cable.astro
 * measures it to decide where the run starts. It is centred on DROP_X, the same
 * number the stub descends on, so the drawn cable and the routed one are one
 * line rather than two a few pixels apart.
 */
interface Props {
  /** Described to screen readers as the hardware, not its contents. */
  alt: string;
}

const { alt } = Astro.props;

/* Screen box in viewBox units, shared by the drawing and the slot below. */
const S = { x: 126, y: 54, w: 352, h: 198 };
const VB = { w: 610, h: 296 };
const pct = (n: number, of: number) => `${(n / of) * 100}%`;

/* Casing and lug in one outline. */
const SHELL =
  "M102 16H564A34 34 0 0 1 598 50V256A34 34 0 0 1 564 290H102" +
  "A34 34 0 0 1 68 256V196C58 194 42 188 38 174C34 162 34 144 38 132" +
  "C42 118 58 112 68 110V50A34 34 0 0 1 102 16Z";

/* The lug's axis: the midpoint of the bulge in the outline above. */
const LUG_Y = 153;

/* --- the right-hand spine ------------------------------------------------- */

/* One key: raised surround, and the cap sitting in it. The gap is what keeps
   twelve keys reading as twelve rather than as one moulded slab. */
const KEY = { w: 26, h: 22, gap: 4 };
const CAP = { w: 19, h: 15 };

/* Centre of the block, and the two datums it hangs from — the display well's
   own top and bottom edges, so the spine and the screen are one band. */
const SPINE_X = 541;
const SPINE_TOP = 44;
const SPINE_BOT = 262;

const BLOCK_W = KEY.w * 3 + KEY.gap * 2;
const COLS = [0, 1, 2].map(
  (i) => SPINE_X - BLOCK_W / 2 + i * (KEY.w + KEY.gap),
);

/* Both clusters are 3x2 on the same column pitch, one hung from each datum. A
   number is a count of bars, which is what the manual prints on the keys with
   no function assigned. */
const CLUSTER_H = KEY.h * 2 + KEY.gap;
const CLUSTERS = [
  {
    rows: [SPINE_TOP, SPINE_TOP + KEY.h + KEY.gap],
    marks: [3, 2, 3, 1, "msg", 2],
  },
  {
    rows: [SPINE_BOT - CLUSTER_H, SPINE_BOT - KEY.h],
    marks: [1, "play", 1, "back", "stop", "fwd"],
  },
] as const;

/* Joystick, on the block's centre and midway between the two clusters. Its
   bowl is drawn a little narrower than the keys above it so the spine reads as
   a column with the keys setting its width. */
const JOY = { cx: SPINE_X, cy: (SPINE_TOP + SPINE_BOT) / 2, r: 41 };

/* The guards are two arcs on the raised rim, each spanning 100 degrees about
   the vertical — wide enough to read as a moulded wing, and leaving the bowl
   open left and right where a thumb pushes it. The stroke is narrower than the
   annulus it sits in on purpose: fill the ring edge to edge and the wing has
   no ground to be raised off, and the whole bowl flattens into one band. */
const GUARD_R = JOY.r - 5.5;
const guard = (up: boolean) => {
  const a = (50 * Math.PI) / 180;
  const dx = GUARD_R * Math.sin(a);
  const y = (JOY.cy + (up ? -1 : 1) * GUARD_R * Math.cos(a)).toFixed(1);
  const [x1, x2] = (up ? [-dx, dx] : [dx, -dx]).map((d) =>
    (JOY.cx + d).toFixed(1),
  );
  return `M${x1} ${y}A${GUARD_R} ${GUARD_R} 0 0 1 ${x2} ${y}`;
};

/* --- the lug ------------------------------------------------------------- */

/* Where the run leaves the drawing. The gland at the foot of this file is set
   from the same number. */
const DROP_X = 12;

/* Strain relief: a moulded taper from inside the lug out to the cable's own
   gauge, nose to the left. Ribs are computed from the taper rather than typed
   beside it, so they cannot drift off the shape they are supposed to be on. */
const BOOT = { nose: 18, root: 52, hn: 5.5, hr: 11.5 };
const bootH = (x: number) =>
  BOOT.hn + ((x - BOOT.nose) / (BOOT.root - BOOT.nose)) * (BOOT.hr - BOOT.hn);
const BOOT_D =
  `M${BOOT.root} ${LUG_Y - BOOT.hr}L${BOOT.nose + BOOT.hn} ${LUG_Y - BOOT.hn}` +
  `A${BOOT.hn} ${BOOT.hn} 0 0 0 ${BOOT.nose + BOOT.hn} ${LUG_Y + BOOT.hn}` +
  `L${BOOT.root} ${LUG_Y + BOOT.hr}Z`;
const RIBS = [24, 28.5, 33];

/* Out of the boot horizontally, then a long easy droop onto the drop line. It
   starts deep inside the boot so the joint is covered rather than butted. */
const STUB =
  `M${BOOT.root - 22} ${LUG_Y}C${DROP_X + 4} ${LUG_Y + 0.5} ` +
  `${DROP_X} ${LUG_Y + 8} ${DROP_X} ${LUG_Y + 25}V${VB.h}`;
---

<div class="pendant">
  <svg viewBox={`0 0 ${VB.w} ${VB.h}`} role="img" aria-label={alt}>
    <defs>
      <clipPath id="pd-shell"><path d={SHELL}></path></clipPath>
    </defs>

    {
      /* Behind the shell, so each is gripped by it rather than parked against
         it: the thumb button on the top shoulder, and the cable and its strain
         relief where they leave the lug. */
    }
    <rect class="pd-thumb" x={SPINE_X - 16} y="8" width="32" height="16" rx="8"
    ></rect>

    <path class="pd-stub-jacket" d={STUB}></path>
    <path class="pd-stub-core" d={STUB}></path>

    <path class="pd-boot" d={BOOT_D}></path>
    {
      RIBS.map((x) => (
        <rect
          class="pd-boot-rib"
          x={x - 1.6}
          y={LUG_Y - bootH(x) + 1.4}
          width="3.2"
          height={(bootH(x) - 1.4) * 2}
          rx="1.6"
        />
      ))
    }

    <path class="pd-shell" d={SHELL}></path>
    {
      /* The rim is the shell's own outline stroked from inside a clip of
         itself, so the light edge follows the moulding all the way round. A
         band across the face instead leaves a crease where its boundary
         crosses, which reads as a fold in the casing. */
    }
    <g clip-path="url(#pd-shell)">
      <path class="pd-rim" d={SHELL}></path>
    </g>
    <path class="pd-edge" d={SHELL}></path>

    {/* Display, sunk in its well. */}
    <rect class="pd-well" x="116" y="44" width="372" height="218" rx="10"
    ></rect>
    <rect class="pd-screen" x={S.x} y={S.y} width={S.w} height={S.h} rx="2"
    ></rect>

    <rect class="pd-rfid" x="84" y="76" width="16" height="7" rx="3.5"></rect>

    {/* Twelve hard buttons, six above the joystick and six below. */}
    {
      CLUSTERS.map((c) =>
        c.rows.map((y, r) =>
          COLS.map((x, i) => {
            const m = c.marks[r * 3 + i];
            const cx = x + KEY.w / 2;
            const cy = y + KEY.h / 2;
            return (
              <g>
                <rect
                  class="pd-bezel"
                  x={x}
                  y={y}
                  width={KEY.w}
                  height={KEY.h}
                  rx="6"
                />
                <rect
                  class="pd-cap"
                  x={x + (KEY.w - CAP.w) / 2}
                  y={y + (KEY.h - CAP.h) / 2}
                  width={CAP.w}
                  height={CAP.h}
                  rx="4"
                />
                {typeof m === "number" &&
                  [...Array(m).keys()].map((b) => (
                    <rect
                      class="pd-mark"
                      x={cx - 5.5}
                      y={cy - (m * 3.6 - 1.9) / 2 + b * 3.6}
                      width="11"
                      height="1.7"
                      rx="0.85"
                    />
                  ))}
                {m === "msg" && (
                  <path
                    class="pd-mark"
                    d={`M${cx - 6} ${cy - 4.5}h10a1.4 1.4 0 0 1 1.4 1.4v4.6a1.4 1.4 0 0 1-1.4 1.4h-5l-3.2 2.8v-2.8h-1.8a1.4 1.4 0 0 1-1.4-1.4v-4.6a1.4 1.4 0 0 1 1.4-1.4z`}
                  />
                )}
                {m === "play" && (
                  <path class="pd-mark" d={`M${cx - 4} ${cy - 5}l8 5-8 5z`} />
                )}
                {m === "stop" && (
                  <rect
                    class="pd-mark"
                    x={cx - 4.5}
                    y={cy - 4.5}
                    width="9"
                    height="9"
                    rx="1"
                  />
                )}
                {m === "back" && (
                  <path
                    class="pd-mark"
                    d={`M${cx + 5.5} ${cy - 5}v10l-7-5zM${cx - 5.5} ${cy - 5}h2v10h-2z`}
                  />
                )}
                {m === "fwd" && (
                  <path
                    class="pd-mark"
                    d={`M${cx - 5.5} ${cy - 5}l7 5-7 5zM${cx + 3.5} ${cy - 5}h2v10h-2z`}
                  />
                )}
              </g>
            );
          }),
        ),
      )
    }

    {/* Joystick: bezel, guard wings, recess, serrated collar, knob. */}
    <circle class="pd-bowl" cx={JOY.cx} cy={JOY.cy} r={JOY.r}></circle>
    <circle class="pd-bowl-in" cx={JOY.cx} cy={JOY.cy} r={JOY.r - 11}></circle>
    <path class="pd-guard" d={guard(true)}></path>
    <path class="pd-guard" d={guard(false)}></path>
    <circle class="pd-knob" cx={JOY.cx} cy={JOY.cy} r="21"></circle>
    <circle class="pd-collar" cx={JOY.cx} cy={JOY.cy} r="18"></circle>
    <circle class="pd-knob-top" cx={JOY.cx} cy={JOY.cy} r="9.5"></circle>

    {
      /* The stop, on the lug's axis beside the connector and straddling the
         edge, on the yellow ISO 13850 asks for behind it. It cannot be centred
         on the lug as well as sized like a mushroom — a 23-unit collar is wider
         than the boss is — so it is centred on the axis and rides the face. */
    }
    <circle class="pd-estop-field" cx="76" cy={LUG_Y} r="23"></circle>
    <circle class="pd-estop" cx="76" cy={LUG_Y} r="17"></circle>
  </svg>

  <div
    class="screen"
    style={`left:${pct(S.x, VB.w)};top:${pct(S.y, VB.h)};width:${pct(S.w, VB.w)};height:${pct(S.h, VB.h)}`}
  >
    <slot />
  </div>

  {/* Where the cable leaves. Measured by Cable.astro, never drawn. */}
  <span
    class="gland"
    data-cable-start
    aria-hidden="true"
    style={`left:${pct(DROP_X - 3, VB.w)};width:${pct(6, VB.w)};top:${pct(292, VB.h)}`}
  ></span>
</div>

<style>
  /* No ceiling here. How big the pendant is drawn is the page's decision, and
     on /work it is the picture rather than an inset beside the headline. */
  .pendant {
    position: relative;
    width: 100%;
  }

  .pendant svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .screen {
    position: absolute;
    overflow: hidden;
  }

  .gland {
    position: absolute;
    height: 2px;
  }

  /* Shell. Mid grey, not the graphite the page is on: the real unit is a light
     casing and it has to read as an object put down on the placard rather than
     a shape cut out of it. */
  .pd-shell {
    fill: #5a6067;
  }
  .pd-rim {
    fill: none;
    stroke: #6c737b;
    stroke-width: 16;
  }
  .pd-edge {
    fill: none;
    stroke: #23272b;
    stroke-width: 2.5;
  }

  .pd-well {
    fill: #2a2f34;
  }
  /* Painted flat black so that any part of the box the video does not reach is
     the pendant's own screen rather than a hole in the drawing. */
  .pd-screen {
    fill: #05070a;
  }

  .pd-rfid {
    fill: #464c52;
  }

  /* Each key sits in a raised surround, which is what the manual draws and what
     keeps a pale cap from reading as a sticker on flat grey. The cap is held
     below the rim's own brightness: twelve of them at full white pull the eye
     off the screen, which is the one thing on the drawing worth looking at. */
  .pd-bezel {
    fill: #474d55;
  }
  .pd-cap {
    fill: #b2b7be;
  }
  .pd-mark {
    fill: #23272b;
  }

  .pd-bowl {
    fill: #464c54;
  }
  .pd-bowl-in {
    fill: #2a3036;
  }
  .pd-guard {
    fill: none;
    stroke: #79818b;
    stroke-width: 7;
    stroke-linecap: round;
  }
  .pd-knob {
    fill: #1b1f23;
  }
  /* A dashed ring is the serration on the knob's collar: the gaps are the
     flutes, and there is no second path to keep in step with the radius. One
     ring and a domed top is the whole knob — the concentric rims this used to
     carry turned it into a dartboard at any size worth drawing. Knurling is a
     rim, not a fan, so the ring is thin and set near the knob's edge; run it
     deep and the flutes reach the middle and the knob becomes a turbine. */
  .pd-collar {
    fill: none;
    stroke: #363d44;
    stroke-width: 4.5;
    stroke-dasharray: 2.6 3.4;
  }
  .pd-knob-top {
    fill: #3a4148;
  }

  /* The one place the world's signal colour lands on the hardware, and it is
     the one place the hardware would carry it anyway. Outlined rather than
     ringed: a second circle inside the cap turns the mushroom into a bullseye. */
  .pd-estop-field {
    fill: var(--sig);
  }
  .pd-estop {
    fill: #d9402c;
    stroke: #93281a;
    stroke-width: 2.5;
  }

  .pd-thumb {
    fill: #33383e;
    stroke: #23272b;
    stroke-width: 2;
  }

  /* Outlined, because a black boot on a graphite page is a few floating ribs
     and nothing to hold them. */
  .pd-boot {
    fill: #1c2024;
    stroke: #3c4046;
    stroke-width: 2;
  }
  .pd-boot-rib {
    fill: #454b52;
  }

  /* The stub is the run: same colours, same gauge. non-scaling-stroke keeps it
     11px and 6px however large the pendant is drawn, so the joint at the gland
     never steps. */
  .pd-stub-jacket,
  .pd-stub-core {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .pd-stub-jacket {
    stroke: #2a2e33;
    stroke-width: 11;
  }
  .pd-stub-core {
    stroke: #3c4046;
    stroke-width: 6;
  }
</style>
