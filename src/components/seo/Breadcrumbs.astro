---
/**
 * Renders from the same trail array that jsonld.ts turns into a
 * BreadcrumbList, so the visible crumbs and the structured data cannot drift
 * apart. e2e/worlds.spec.ts asserts they match.
 */
interface Props {
  trail: { name: string; path: string }[];
}

const { trail } = Astro.props;
const last = trail.length - 1;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {
      trail.map((crumb, i) => (
        <li>
          {i === last ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.path}>{crumb.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: "/";
    margin-inline-end: 0.6rem;
    color: var(--hair);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--sig);
  }

  .crumbs [aria-current="page"] {
    color: var(--ink);
  }
</style>
