---
/**
 * A word inside a stadium that routes its own labels.
 *
 * This is the reference sheets' ONLINE composition: the container is cut to
 * the type rather than drawn around it, and the leaders start on the outline
 * itself, so the labels are attached to the shape and the shape is attached
 * to the word. Delete the word and there is nothing left to draw.
 *
 * The stadium is a border-radius pill sized from the type's own line box, so
 * it needs no measurement pass and no script — it is correct on the first
 * paint and stays correct when the face falls back.
 */
interface Props {
  /** The word inside the track. */
  label: string;
  /** Printed on a leader leaving the top edge. */
  top?: string;
  /** Printed on a leader leaving the bottom edge. */
  bottom?: string;
  signal?: boolean;
  class?: string;
}

const { label, top, bottom, signal = false, class: className } = Astro.props;
---

<div
  class:list={["micro-track", className]}
  data-micro="racetrack"
  data-signal={signal ? "" : undefined}
>
  {
    top && (
      <span class="micro-track-lead" data-at="top">
        <span class="micro-track-text micro-label">{top}</span>
        <span class="micro-track-rule" />
      </span>
    )
  }

  <span class="micro-track-body">
    <span class="micro-track-cap" data-at="start" aria-hidden="true"></span>
    <span class="micro-track-label">{label}</span>
    <span class="micro-track-cap" data-at="end" aria-hidden="true"></span>
  </span>

  {
    bottom && (
      <span class="micro-track-lead" data-at="bottom">
        <span class="micro-track-rule" />
        <span class="micro-track-text micro-label">{bottom}</span>
      </span>
    )
  }
</div>

<style>
  .micro-track {
    display: inline-grid;
    justify-items: start;
    gap: 0;
  }

  /* The pill: padding is set in em so the track is cut from the type at any
     size, and the radius is simply half of whatever that makes it. */
  .micro-track-body {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.42em 1.05em;
    border: var(--rule) solid var(--ink);
    border-radius: 999px;
    line-height: 1;
  }

  .micro-track[data-signal] .micro-track-body {
    border-color: var(--sig);
  }

  .micro-track-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1;
  }

  .micro-track[data-signal] .micro-track-label {
    color: var(--sig);
  }

  /* Terminals sitting on the outline, one open and one closed, so the track
     reads as a route with a direction. */
  .micro-track-cap {
    position: absolute;
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    top: 50%;
    translate: 0 -50%;
    border: var(--rule) solid var(--ink);
    background: var(--sub);
  }

  .micro-track[data-signal] .micro-track-cap {
    border-color: var(--sig);
  }

  .micro-track-cap[data-at="start"] {
    left: -3px;
  }

  .micro-track-cap[data-at="end"] {
    right: -3px;
    background: var(--ink);
  }

  .micro-track[data-signal] .micro-track-cap[data-at="end"] {
    background: var(--sig);
  }

  /* A leader leaves the outline, turns, and carries its label. The vertical
     stub is the connection; without it the caption would just be text near a
     pill. */
  .micro-track-lead {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline-start: 1.6em;
  }

  .micro-track-rule {
    inline-size: 2.2rem;
    block-size: var(--rule);
    background: var(--hair);
    flex: none;
  }

  .micro-track-lead[data-at="top"] {
    margin-block-end: 0.35rem;
  }

  .micro-track-lead[data-at="bottom"] {
    margin-block-start: 0.35rem;
  }

  .micro-track-text {
    white-space: nowrap;
  }

  @media (max-width: 46rem) {
    .micro-track-rule {
      inline-size: 1.2rem;
    }
  }
</style>
