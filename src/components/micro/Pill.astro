---
/**
 * A capsule set into a line of type.
 *
 * The reference sheets' MODULE-D9 (IDLE) device. It is not a badge dropped
 * into the sentence: its height is `1ex`, the face's own x-height, so it sits
 * in the lowercase band and rides the same baseline as the words either side.
 * Sizing it in ex rather than measuring the text means it stays correct at
 * every step of the type scale and with no script at all.
 */
interface Props {
  signal?: boolean;
  class?: string;
}

const { signal = false, class: className } = Astro.props;
---

<span
  class:list={["micro-pill", className]}
  data-micro="pill"
  data-signal={signal ? "" : undefined}><slot /></span
>

<style>
  .micro-pill {
    display: inline-grid;
    place-items: center;
    block-size: 1.85ex;
    padding-inline: 0.72ex;
    border-radius: 999px;
    background: var(--ink);
    color: var(--sub);
    font-family: var(--font-mono);
    font-size: 0.62em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    /* Sits in the lowercase band rather than on the cap line. */
    translate: 0 -0.08ex;
  }

  .micro-pill[data-signal] {
    background: var(--sig);
  }
</style>
