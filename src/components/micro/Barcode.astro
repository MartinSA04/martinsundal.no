---
interface Props {
  seed: string;
  bars?: number;
  class?: string;
}

const { seed, bars: count = 24, class: className } = Astro.props;

/* FNV-1a, so a given seed always yields the same strip across builds. */
let h = 2166136261;
for (const ch of seed) {
  h ^= ch.charCodeAt(0);
  h = Math.imul(h, 16777619);
}
const bars = Array.from({ length: count }, (_, i) => {
  h = Math.imul(h ^ i, 16777619);
  return {
    w: ((h >>> 8) % 3) + 1,
    // Height varies too, otherwise a run of bars reads as a flat hatch
    // rather than as a strip of data.
    h: 45 + ((h >>> 17) % 56),
  };
});
---

<span
  class:list={["micro-barcode", className]}
  data-micro="barcode"
  data-seed={seed}
  aria-hidden="true"
>
  {bars.map((b) => <i style={`--w:${b.w}px; --h:${b.h}%`} />)}
</span>
