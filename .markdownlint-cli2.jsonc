{
  "config": {
    // Line length is managed by the editor, not enforced.
    "MD013": false
  },
  "globs": ["docs/**/*.md"],
  "overrides": [
    {
      "globs": ["src/content/**/*.md"],
      "config": {
        // Content bodies start at h2 on purpose: the h1 is the project name,
        // rendered by the page layout from frontmatter.
        "MD041": false
      }
    }
  ]
}
